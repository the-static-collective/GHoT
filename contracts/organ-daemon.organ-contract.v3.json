{
  "schema": "relatte.organ-contract/v0",
  "contract_id": "ghot.organ-daemon@3",
  "version": "3",
  "owner_project": "GHoT",
  "description": "One-process GHoT organ supervisor with versioned durable state, boot presence, trusted authority work, and a shared HOLD-only parcel porch for state parcels and declarative merge-plugin packages.",
  "accepted_crossing_kinds": [],
  "input_schema_refs": [
    "https://the-static-collective.github.io/GHoT/schemas/body.v0.json",
    "https://the-static-collective.github.io/GHoT/schemas/organ-state.v1.json",
    "https://the-static-collective.github.io/GHoT/schemas/organ-event.v0.json",
    "https://the-static-collective.github.io/GHoT/schemas/state-parcel-bundle.v0.json",
    "https://the-static-collective.github.io/GHoT/schemas/merge-plugin-parcel-bundle.v0.json"
  ],
  "allowed_dispositions": [
    "OBSERVE",
    "RETRY",
    "SERVE",
    "POLL",
    "HOLD_STATE",
    "HOLD_PLUGIN_PACKAGE"
  ],
  "effect_classes": ["none","local-state-change"],
  "receipt_kinds": [],
  "authority_scope": "supervisor-only",
  "dependencies": [
    "ghot.body/v0",
    "ghot.field/v0",
    "ghot.authority.advert/v0",
    "ghot.authority.trust/v0",
    "ghot.work-lease/v0",
    "ghot.boot-presence@0",
    "ghot.state-migration@0",
    "ghot.state-parcel-inbox@0",
    "ghot.merge-plugin-parcel-inbox@0"
  ],
  "implementation_refs": [
    "ghot/organ.py",
    "ghot/state_migration.py",
    "ghot/state_parcel.py",
    "ghot/merge_plugin_parcel.py"
  ],
  "non_authorities": [
    "daemon supervision is not task authority",
    "daemon liveness is not lease authority",
    "parcel porch receive is not state admission",
    "parcel porch receive is not plugin validation",
    "parcel porch receive is not plugin installation",
    "shared porch is not shared semantics",
    "boot presence is not admission"
  ],
  "extensions": {
    "durable_current_state": ".ghot/organ/state.v1.json",
    "presence_link_required": true,
    "parcel_porch_port_default": 7792,
    "parcel_porch_endpoints": [
      "/state-parcel",
      "/merge-plugin-package"
    ],
    "state_parcel_network_disposition": "HOLD",
    "merge_plugin_network_disposition": "HOLD",
    "state_parcel_network_admit": false,
    "merge_plugin_network_validate": false,
    "merge_plugin_network_install": false,
    "owner_lease_authority_preserved": true
  }
}
