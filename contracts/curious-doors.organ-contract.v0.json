  "accepted_crossing_kinds": [],
  "input_schema_refs": [
    "https://the-static-collective.github.io/GHoT/schemas/composition-want.v0.json",
    "https://the-static-collective.github.io/GHoT/schemas/composition-want-observation.v0.json",
    "https://the-static-collective.github.io/GHoT/schemas/composition-want-request-link.v0.json",
    "https://the-static-collective.github.io/GHoT/schemas/curiosity-door.v0.json",
    "https://the-static-collective.github.io/GHoT/schemas/curiosity-surface.v0.json"
  ],
  "allowed_dispositions": [
    "SNAPSHOT",
    "RENDER_HTML",
    "SERVE_READ_ONLY"
