{
  "schema": "relatte.organ-contract/v0",
  "contract_id": "ghot.portable-work-lease-authority@1",
  "version": "1",
  "owner_project": "GHoT",
  "description": "Owner-local P-256 portable HOLD lease authority with automatic identity-bound remote dispatch.",
  "accepted_crossing_kinds": [
    "GHOT_LEASE_POLL",
    "GHOT_LEASE_CLAIM",
    "GHOT_LEASE_RENEW",
    "GHOT_LEASE_COMPLETE",
    "GHOT_LEASE_ABANDON"
  ],
  "input_schema_refs": [
    "https://the-static-collective.github.io/reLATTE/schemas/crossing-envelope-v0.schema.json"
  ],
  "allowed_dispositions": ["HOLD", "ADMIT", "REFUSE", "RETURN"],
  "effect_classes": [
    "none",
    "local-state-change",
    "capability-issued",
    "capability-revoked",
    "return-created"
  ],
  "receipt_kinds": [
    "VERIFIED", "ADMITTED", "REFUSED", "RETURNED", "EXECUTED", "FAILED"
  ],
  "authority_scope": "owner-local",
  "dependencies": [
    "ghot.hold/v0",
    "ghot.dispatch/v1",
    "ghot.claim/v0",
    "ghot.work-lease/v0",
    "relatte.crossing-envelope/v0",
    "relatte.receipt/v0",
    "relatte.identity-signature/v0"
  ],
  "implementation_refs": [
    "ghot/relatte_identity.py",
    "ghot/lease_authority.py",
    "ghot/portable_lease.py",
    "ghot/lease_remote.py",
    "ghot/wake_composer.py"
  ],
  "non_authorities": [
    "remote worker is not queue owner",
    "scheduler selection is not lease admission",
    "remote execution receipt does not release a HOLD by itself",
    "network transport does not select the worker",
    "discovery does not grant a lease",
    "signature does not establish human identity or semantic truth",
    "authority advert retrieval does not by itself prove intended authority identity"
  ],
  "extensions": {
    "dispatch_required_before_claim": true,
    "automatic_dispatch_from_owner_plan": true,
    "dispatch_bound_to_selected_p256_particular": true,
    "single_writer_claim_authority": true,
    "crossing_replay_is_idempotent": true,
    "source_verification_profile": "relatte.identity-signature/v0",
    "public_key_identity_claimed": true
  }
}
