{
  "schema": "relatte.organ-contract/v0",
  "contract_id": "ghot.composition-wants@0",
  "version": "0",
  "owner_project": "GHoT",
  "description": "Ground composition gaps in concrete ADMITTED parcels, identify exact-shape observed grammar candidates without ranking them, persist explicit local wants, and require candidate-specific operator action before creating a normal 023 request.",
  "accepted_crossing_kinds": [],
  "input_schema_refs": [
    "https://the-static-collective.github.io/GHoT/schemas/composition-candidate.v0.json",
    "https://the-static-collective.github.io/GHoT/schemas/composition-gap.v0.json",
    "https://the-static-collective.github.io/GHoT/schemas/composition-want.v0.json",
    "https://the-static-collective.github.io/GHoT/schemas/composition-want-request-link.v0.json",
    "https://the-static-collective.github.io/GHoT/schemas/grammar-exchange-advert.v0.json"
  ],
  "allowed_dispositions": [
    "INSPECT_GAP",
    "DECLARE_WANT",
    "LIST_WANTS",
    "SHOW_WANT",
    "REQUEST_CANDIDATE"
  ],
  "effect_classes": ["none","local-state-change"],
  "receipt_kinds": [],
  "authority_scope": "owner-local",
  "dependencies": [
    "ghot.merge-contract-pantry@0",
    "ghot.grammar-exchange@0"
  ],
  "implementation_refs": [
    "ghot/composition_want.py",
    "ghot/merge_contract_pantry.py",
    "ghot/grammar_exchange.py"
  ],
  "non_authorities": [
    "gap is not request",
    "candidate is not recommendation",
    "one candidate is not automatic choice",
    "want is not authority",
    "candidate observation is not durable entitlement",
    "want snapshot is not proof candidate remains shared",
    "request link is not offer",
    "request is not crossing",
    "gap disappearance blocks further request",
    "candidate source title/category are not matching authority"
  ],
  "extensions": {
    "gap_grounding": "one concrete ADMITTED state parcel",
    "candidate_match": "exact source kind/version/selector/payload-type only",
    "candidate_ranking": false,
    "automatic_want": false,
    "automatic_request": false,
    "automatic_offer": false,
    "automatic_install": false,
    "zero_candidate_want_allowed": true,
    "candidate_revalidation_before_request": true,
    "local_gap_revalidation_before_request": true
  }
}
