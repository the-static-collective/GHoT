{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/lightwalker-labor-writ-redemption-receipt.v0.json",
  "title": "GHoT Lightwalker Labor Writ Redemption Receipt V0",
  "type": "object",
  "required": ["kind","version","issuer_particular","writ_id","redemption_request_id","redeemer_particular","scope_digest","observed_cut","status","writ_exhausted","performance_completed","laws","redemption_receipt_id","signing"],
  "properties": {
    "kind": { "const": "ghot.lightwalker.labor-writ-redemption-receipt" },
    "version": { "const": "0" },
    "issuer_particular": { "type": "string", "minLength": 1 },
    "writ_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "redemption_request_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "redeemer_particular": { "type": "string", "minLength": 1 },
    "scope_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "observed_cut": { "type": "integer", "minimum": 0 },
    "status": { "const": "REDEEMED" },
    "writ_exhausted": { "const": true },
    "performance_completed": { "const": false },
    "laws": { "type": "array", "items": { "type": "string" } },
    "redemption_receipt_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "signing": { "type": "object" }
  },
  "additionalProperties": false
}