{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-region-coverage-attestation.v0.json",
  "title":"GHoT Lightwalker Region Coverage Attestation V0",
  "type":"object",
  "required":["kind","version","authority","pixel_region_plan_id","continuation_lineage_id","work_address","parent_checkpoint_id","attestor_particular","cumulative_work_measure","region_count","region_claims","execution_authority","settlement_authority","laws","region_coverage_attestation_id","signing"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.region-coverage-attestation"},
    "version":{"const":"0"},
    "authority":{"const":"owner-local-accepted-region-coverage-attestation"},
    "pixel_region_plan_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "continuation_lineage_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "work_address":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "parent_checkpoint_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "attestor_particular":{"type":"string","minLength":1},
    "cumulative_work_measure":{"type":"object"},
    "region_count":{"type":"integer","minimum":1},
    "region_claims":{"type":"array","minItems":1,"items":{"type":"object"}},
    "execution_authority":{"const":"none"},
    "settlement_authority":{"const":"none"},
    "laws":{"type":"array","items":{"type":"string"}},
    "region_coverage_attestation_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "signing":{"type":"object"}
  },
  "additionalProperties":false
}