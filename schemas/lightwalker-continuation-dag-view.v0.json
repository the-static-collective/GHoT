{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-continuation-dag-view.v0.json",
  "title":"GHoT Lightwalker Continuation DAG View V0",
  "type":"object",
  "required":["kind","version","authority","continuation_lineage_id","root_run_id","root_checkpoint_id","resume_ids","checkpoint_ids","handoff_ids","continuation_node_ids","resource_reservation_ids","resource_reservations_distinct","status","live_leaf_ids","live_leaf_count","terminal_leaf_id","full_checkpoint_ancestry","source_work_measure","cumulative_work_before_leaf","remaining_work_at_leaf_start","global_consensus","execution_authority","laws","continuation_dag_id"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.continuation-dag-view"},
    "version":{"const":"0"},
    "authority":{"const":"derived-continuation-lineage-observation"},
    "continuation_lineage_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "root_run_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "root_checkpoint_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "resume_ids":{"type":"array","items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
    "checkpoint_ids":{"type":"array","items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
    "handoff_ids":{"type":"array","items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
    "continuation_node_ids":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
    "resource_reservation_ids":{"type":"array","minItems":3,"items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
    "resource_reservations_distinct":{"const":true},
    "status":{"enum":["ACTIVE","COMPLETED"]},
    "live_leaf_ids":{"type":"array","maxItems":1,"items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
    "live_leaf_count":{"type":"integer","minimum":0,"maximum":1},
    "terminal_leaf_id":{"type":["string","null"]},
    "full_checkpoint_ancestry":{"type":"array","minItems":2,"items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
    "source_work_measure":{"type":"object"},
    "cumulative_work_before_leaf":{"type":"object"},
    "remaining_work_at_leaf_start":{"type":"object"},
    "global_consensus":{"const":false},
    "execution_authority":{"const":"none"},
    "laws":{"type":"array","items":{"type":"string"}},
    "continuation_dag_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties":false
}