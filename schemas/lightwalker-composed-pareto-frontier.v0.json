{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-composed-pareto-frontier.v0.json",
  "title":"GHoT Lightwalker Composed Pareto Frontier V0",
  "type":"object",
  "required":["kind","version","authority","evaluation_id","intersection_id","promise_id","source_slot_id","frontier","dominated","winner","local_score","policy_provenance","override_authority","reservation_authority","laws","frontier_id"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.composed-pareto-frontier"},
    "version":{"const":"0"},
    "authority":{"const":"derived-composed-pareto-view-only"},
    "evaluation_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "intersection_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "promise_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "source_slot_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "frontier":{"type":"array","items":{"type":"object"}},
    "dominated":{"type":"array","items":{"type":"object"}},
    "winner":{"type":"null"},
    "local_score":{"type":"null"},
    "policy_provenance":{"type":"array","minItems":2,"items":{"type":"object"}},
    "override_authority":{"const":"none"},
    "reservation_authority":{"const":"none"},
    "laws":{"type":"array","items":{"type":"string"}},
    "frontier_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties":false
}