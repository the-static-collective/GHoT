{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/lightwalker-guild-resource-reservation.v0.json",
  "title": "GHoT Lightwalker Guild Resource Reservation V0",
  "type": "object",
  "required": ["kind","version","authority","guild_id","snapshot_id","proposal_id","authorization_id","resource_entry_id","resource_subject_ref","steward_particular","reserved_measure","authorized_at_cut","expires_after_cut","status","laws","reservation_id","signing"],
  "properties": {
    "kind": { "const": "ghot.lightwalker.guild-resource-reservation" },
    "version": { "const": "0" },
    "authority": { "const": "guild-local-capacity-reservation" },
    "guild_id": { "type": "string", "minLength": 1 },
    "snapshot_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "proposal_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "authorization_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "resource_entry_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "resource_subject_ref": { "type": "string", "minLength": 1 },
    "steward_particular": { "type": "string", "minLength": 1 },
    "reserved_measure": {
      "type": "object",
      "required": ["unit","quantity"],
      "properties": {
        "unit": { "type": "string", "minLength": 1 },
        "quantity": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "authorized_at_cut": { "type": "integer", "minimum": 0 },
    "expires_after_cut": { "type": "integer", "minimum": 0 },
    "status": { "const": "ACTIVE" },
    "laws": { "type": "array", "items": { "type": "string" } },
    "reservation_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "signing": { "type": "object" }
  },
  "additionalProperties": false
}