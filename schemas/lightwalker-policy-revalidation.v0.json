{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-policy-revalidation.v0.json",
  "title":"GHoT Lightwalker Policy Revalidation V0",
  "type":"object",
  "required":["kind","version","authority","promise_id","source_slot_id","reservation_id","prior_binding_id","prior_admission_response_id","previous_policy_set_id","current_policy_set_id","current_policy_version_ids","candidate_remote_proof_id","evaluation_id","intersection_id","evaluated_at_cut","status","policy_failures","future_execution_permitted","old_admission_rewritten","reservation_rewritten","history_erased","automatic_release","laws","revalidation_id"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.policy-revalidation"},
    "version":{"const":"0"},
    "authority":{"const":"derived-policy-revalidation-only"},
    "promise_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "source_slot_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "reservation_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "prior_binding_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "prior_admission_response_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "previous_policy_set_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "current_policy_set_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "current_policy_version_ids":{"type":"array","minItems":1,"items":{"type":"string"}},
    "candidate_remote_proof_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "evaluation_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "intersection_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "evaluated_at_cut":{"type":"integer","minimum":0},
    "status":{"enum":["COMPLIANT","NONCOMPLIANT"]},
    "policy_failures":{"type":"array","items":{"type":"object"}},
    "future_execution_permitted":{"type":"boolean"},
    "old_admission_rewritten":{"const":false},
    "reservation_rewritten":{"const":false},
    "history_erased":{"const":false},
    "automatic_release":{"const":false},
    "laws":{"type":"array","items":{"type":"string"}},
    "revalidation_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties":false
}