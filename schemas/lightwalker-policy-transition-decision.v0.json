{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-policy-transition-decision.v0.json",
  "title":"GHoT Lightwalker Policy Transition Decision V0",
  "type":"object",
  "required":["kind","version","authority","transition_id","mode","reservation_id","reservation_authorized_at_cut","reservation_expires_after_cut","execution_started_at_cut","observed_cut","phase","action","legacy_path_open","revalidation_required","migration_required","enforcement_deferred_until_cut","policy_content_changed","reservation_rewritten","resource_owner_action_taken","laws","decision_id"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.policy-transition-decision"},
    "version":{"const":"0"},
    "authority":{"const":"derived-transition-gate-only"},
    "transition_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "mode":{"type":"string"},
    "reservation_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "reservation_authorized_at_cut":{"type":"integer","minimum":0},
    "reservation_expires_after_cut":{"type":"integer","minimum":0},
    "execution_started_at_cut":{"type":["integer","null"],"minimum":0},
    "observed_cut":{"type":"integer","minimum":0},
    "phase":{"enum":["BEFORE_CURRENT_POLICY_EFFECTIVE","CURRENT_POLICY_EFFECTIVE"]},
    "action":{"type":"string","minLength":1},
    "legacy_path_open":{"type":"boolean"},
    "revalidation_required":{"type":"boolean"},
    "migration_required":{"type":"boolean"},
    "enforcement_deferred_until_cut":{"type":["integer","null"],"minimum":0},
    "policy_content_changed":{"const":false},
    "reservation_rewritten":{"const":false},
    "resource_owner_action_taken":{"const":false},
    "laws":{"type":"array","items":{"type":"string"}},
    "decision_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties":false
}