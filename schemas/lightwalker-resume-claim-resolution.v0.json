{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-resume-claim-resolution.v0.json",
  "title":"GHoT Lightwalker Resume Claim Resolution V0",
  "type":"object",
  "required":["kind","version","authority","source_run_id","source_checkpoint_id","source_steward_particular","fork_id","resume_claim_ids","rule","winning_resume_claim_id","losing_resume_claim_ids","claim_deleted","global_consensus","execution_authority","laws","resume_resolution_id","signing"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.resume-claim-resolution"},
    "version":{"const":"0"},
    "authority":{"const":"checkpoint-owner-local-resume-fork-resolution"},
    "source_run_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "source_checkpoint_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "source_steward_particular":{"type":"string","minLength":1},
    "fork_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "resume_claim_ids":{"type":"array","minItems":2,"items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
    "rule":{"const":"lowest-claim-id"},
    "winning_resume_claim_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "losing_resume_claim_ids":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
    "claim_deleted":{"const":false},
    "global_consensus":{"const":false},
    "execution_authority":{"const":"none"},
    "laws":{"type":"array","items":{"type":"string"}},
    "resume_resolution_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "signing":{"type":"object"}
  },
  "additionalProperties":false
}