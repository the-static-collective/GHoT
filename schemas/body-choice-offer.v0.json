{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/body-choice-offer.v0.json",
  "title": "GHoT Body Choice Offer V0",
  "type": "object",
  "required": ["kind", "version", "offer_id", "capability", "observed_at", "requester_node_id", "candidates", "laws"],
  "properties": {
    "kind": { "const": "ghot.body-choice.offer" },
    "version": { "const": "0" },
    "offer_id": { "type": "string", "pattern": "^ghot-body-offer-v0:" },
    "capability": { "type": "string", "minLength": 1 },
    "observed_at": { "type": "string" },
    "requester_node_id": { "type": "string", "minLength": 1 },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "location", "eligible", "rejected"],
        "properties": {
          "node_id": { "type": "string", "minLength": 1 },
          "location": { "enum": ["local", "remote"] },
          "eligible": { "type": "boolean" },
          "rejected": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "laws": { "type": "array", "items": { "type": "string" } }
  }
}
