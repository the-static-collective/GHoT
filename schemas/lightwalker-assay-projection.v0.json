{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/lightwalker-assay-projection.v0.json",
  "title": "GHoT Lightwalker Assay Projection V0",
  "type": "object",
  "required": [
    "kind","version","authority","realm_id","workmark_id","lens_id",
    "measurement_receipt_digest","cut","status","unit","quantity",
    "source_metrics","laws","projection_id"
  ],
  "properties": {
    "kind": { "const": "ghot.lightwalker.assay-projection" },
    "version": { "const": "0" },
    "authority": { "const": "realm-local" },
    "realm_id": { "type": "string", "minLength": 1 },
    "workmark_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "lens_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "measurement_receipt_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "cut": { "type": "integer", "minimum": 0 },
    "status": { "const": "ELIGIBLE" },
    "unit": { "type": "string", "minLength": 1 },
    "quantity": { "type": "integer", "minimum": 0 },
    "source_metrics": { "type": "object" },
    "laws": { "type": "array", "items": { "type": "string" } },
    "projection_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
