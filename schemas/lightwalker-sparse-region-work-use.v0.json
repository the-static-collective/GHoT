{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-sparse-region-work-use.v0.json",
  "title":"GHoT Lightwalker Sparse Region Work Use V0",
  "type":"object",
  "required":["kind","version","authority","sparse_region_lease_id","exact_missing_region_set_id","pixel_region_plan_id","work_address","node_particular","region_count","consumed_region_ids","region_claim_set_id","region_claims","capacity_proposal_id","capacity_authorization_id","capacity_reservation_id","capacity_execution_receipt_id","capacity_finalization_id","consumed_work_measure","result_ref","observed_cut","compute_capacity_authority","continuation_authority","settlement_authority","laws","sparse_region_use_id","signing"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.sparse-region-work-use"},
    "version":{"const":"0"},
    "authority":{"const":"node-local-sparse-region-result"},
    "sparse_region_lease_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "exact_missing_region_set_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "pixel_region_plan_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "work_address":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "node_particular":{"type":"string","minLength":1},
    "region_count":{"type":"integer","minimum":1},
    "consumed_region_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
    "region_claim_set_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "region_claims":{"type":"array","minItems":1,"items":{"type":"object"}},
    "capacity_proposal_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "capacity_authorization_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "capacity_reservation_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "capacity_execution_receipt_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "capacity_finalization_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "consumed_work_measure":{"type":"object"},
    "result_ref":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "observed_cut":{"type":"integer","minimum":0},
    "compute_capacity_authority":{"const":"external-local-evidence"},
    "continuation_authority":{"const":"none"},
    "settlement_authority":{"const":"none"},
    "laws":{"type":"array","items":{"type":"string"}},
    "sparse_region_use_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "signing":{"type":"object"}
  },
  "additionalProperties":false
}