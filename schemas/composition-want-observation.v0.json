{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/composition-want-observation.v0.json",
  "title": "GHoT Composition Want Observation V0",
  "type": "object",
  "required": [
    "kind","version","observation_id","want_id","gap_id",
    "source","candidates","observed_at"
  ],
  "properties": {
    "kind": { "const": "ghot.composition.want-observation" },
    "version": { "const": "0" },
    "observation_id": { "type": "string", "minLength": 1 },
    "want_id": { "type": "string", "minLength": 1 },
    "gap_id": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "required": ["state_kind","state_version","selector","payload_type"]
    },
    "candidates": { "type": "array", "items": { "type": "object" } },
    "observed_at": { "type": "string" }
  }
}
