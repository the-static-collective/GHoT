{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/activation-claim.v0.json",
  "title": "GHoT Activation Claim V0",
  "type": "object",
  "required": [
    "kind","version","ticket_id","launch_id","claimed_at","one_operation"
  ],
  "properties": {
    "kind": { "const": "ghot.activation.claim" },
    "version": { "const": "0" },
    "ticket_id": { "type": "string", "minLength": 1 },
    "launch_id": { "type": "string", "minLength": 1 },
    "claimed_at": { "type": "string" },
    "one_operation": { "const": true }
  }
}
