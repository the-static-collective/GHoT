{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/lightwalker-capacity-backed-service-promise.v0.json",
  "title": "GHoT Lightwalker Capacity-Backed Service Promise V0",
  "type": "object",
  "required": ["kind","version","authority","guild_id","snapshot_id","resource_entry_id","resource_subject_ref","steward_particular","executor_particular","offer_id","service_obligation_id","promised_measure","promised_at_cut","valid_through_cut","capacity_encumbered","execution_authority_granted","performance_proven","laws","promise_id","signing"],
  "properties": {
    "kind": { "const": "ghot.lightwalker.capacity-backed-service-promise" },
    "version": { "const": "0" },
    "authority": { "const": "guild-promise-capacity-referenced" },
    "guild_id": { "type": "string", "minLength": 1 },
    "snapshot_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "resource_entry_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "resource_subject_ref": { "type": "string", "minLength": 1 },
    "steward_particular": { "type": "string", "minLength": 1 },
    "executor_particular": { "type": "string", "minLength": 1 },
    "offer_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "service_obligation_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "promised_measure": {
      "type": "object",
      "required": ["unit","quantity"],
      "properties": {
        "unit": { "type": "string", "minLength": 1 },
        "quantity": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "promised_at_cut": { "type": "integer", "minimum": 0 },
    "valid_through_cut": { "type": "integer", "minimum": 0 },
    "capacity_encumbered": { "const": false },
    "execution_authority_granted": { "const": false },
    "performance_proven": { "const": false },
    "laws": { "type": "array", "items": { "type": "string" } },
    "promise_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "signing": { "type": "object" }
  },
  "additionalProperties": false
}