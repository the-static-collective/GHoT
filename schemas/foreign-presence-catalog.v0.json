{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/foreign-presence-catalog.v0.json",
  "title": "GHoT Foreign Presence Catalog V0",
  "type": "object",
  "required": ["kind","version","entries","merged_parcels"],
  "properties": {
    "kind": { "const": "ghot.foreign-presence-catalog" },
    "version": { "const": "0" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_particular","source_node_id","boot_id","manifest_address",
          "startup_receipt_id","parcel_id","payload_address"
        ],
        "properties": {
          "source_particular": { "type": "string", "minLength": 1 },
          "source_node_id": { "type": "string", "minLength": 1 },
          "boot_id": { "type": ["string","null"] },
          "manifest_address": { "type": ["string","null"] },
          "startup_receipt_id": { "type": ["string","null"] },
          "parcel_id": { "type": "string", "minLength": 1 },
          "payload_address": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "merged_parcels": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
