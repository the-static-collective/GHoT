{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-federated-substitute-request.v0.json",
  "title":"GHoT Lightwalker Federated Substitute Request V0",
  "type":"object",
  "required":["kind","version","authority","promisor_particular","promise_id","offer_id","acceptance_id","reroute_id","original_source_id","substitute_capacity_guild_id","substitute_snapshot_id","substitute_remote_proof_id","substitute_resource_entry_id","requested_measure","requested_at_cut","reservation_authority","ownership_transfer_requested","laws","request_id","signing"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.federated-substitute-request"},
    "version":{"const":"0"},
    "authority":{"const":"promisor-substitute-request-only"},
    "promisor_particular":{"type":"string","minLength":1},
    "promise_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "offer_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "acceptance_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "reroute_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "original_source_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "substitute_capacity_guild_id":{"type":"string","minLength":1},
    "substitute_snapshot_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "substitute_remote_proof_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "substitute_resource_entry_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "requested_measure":{"type":"object"},
    "requested_at_cut":{"type":"integer","minimum":0},
    "reservation_authority":{"const":"none"},
    "ownership_transfer_requested":{"const":false},
    "laws":{"type":"array","items":{"type":"string"}},
    "request_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "signing":{"type":"object"}
  },
  "additionalProperties":false
}