{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/grammar-exchange-advert.v0.json",
  "title": "GHoT Grammar Exchange Advert V0",
  "type": "object",
  "required": [
    "kind","version","advert_id","node_id","particular","public_key",
    "exchange_port","parcel_port","packages","issued_at","ttl_seconds","signing"
  ],
  "properties": {
    "kind": { "const": "ghot.grammar.exchange.advert" },
    "version": { "const": "0" },
    "advert_id": { "type": "string", "minLength": 1 },
    "node_id": { "type": "string", "minLength": 1 },
    "particular": { "type": "string", "minLength": 1 },
    "public_key": { "type": "object" },
    "exchange_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "parcel_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "packages": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": [
          "package_id","package_version","package_address","contract_id",
          "title","category","author_particular","shareable"
        ],
        "properties": {
          "package_id": { "type": "string", "minLength": 1 },
          "package_version": { "type": "string", "minLength": 1 },
          "package_address": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "contract_id": { "type": "string", "minLength": 1 },
          "title": { "type": ["string","null"] },
          "category": { "type": ["string","null"] },
          "author_particular": { "type": ["string","null"] },
          "shareable": { "const": true }
        }
      }
    },
    "issued_at": { "type": "string" },
    "ttl_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
    "signing": {
      "type": "object",
      "required": ["algorithm","public_key","signature","domain"],
      "properties": {
        "algorithm": { "const": "ECDSA-P256-SHA256" },
        "public_key": { "type": "object" },
        "signature": { "type": "string", "minLength": 1 },
        "domain": { "const": "ghot.grammar-exchange-advert-signature/v0" }
      }
    }
  }
}
