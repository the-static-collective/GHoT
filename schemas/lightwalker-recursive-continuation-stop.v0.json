{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-recursive-continuation-stop.v0.json",
  "title":"GHoT Lightwalker Recursive Continuation Stop V0",
  "type":"object",
  "required":["kind","version","authority","continuation_lineage_id","parent_node_id","recursive_checkpoint_id","reservation_id","reservation_finalization_id","reservation_status","steward_particular","stopped_at_cut","reason","total_progress_percent","service_complete","history_rewritten","settlement_authority","laws","recursive_stop_id","signing"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.recursive-continuation-stop"},
    "version":{"const":"0"},
    "authority":{"const":"owner-local-recursive-stop"},
    "continuation_lineage_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "parent_node_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "recursive_checkpoint_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "reservation_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "reservation_finalization_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "reservation_status":{"const":"PARTIALLY_CONSUMED"},
    "steward_particular":{"type":"string","minLength":1},
    "stopped_at_cut":{"type":"integer","minimum":0},
    "reason":{"type":"string","minLength":1},
    "total_progress_percent":{"type":"integer","minimum":1,"maximum":99},
    "service_complete":{"const":false},
    "history_rewritten":{"const":false},
    "settlement_authority":{"const":"none"},
    "laws":{"type":"array","items":{"type":"string"}},
    "recursive_stop_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "signing":{"type":"object"}
  },
  "additionalProperties":false
}