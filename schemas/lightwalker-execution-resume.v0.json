{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-execution-resume.v0.json",
  "title":"GHoT Lightwalker Execution Resume V0",
  "type":"object",
  "required":["kind","version","authority","old_run_id","old_reservation_id","source_checkpoint_id","source_pause_id","source_stop_id","source_partial_result_ref","prior_progress_percent","remaining_work_percent","source_work_measure","prior_work_measure","remaining_work_measure","new_guild_id","new_reservation_id","new_authorization_id","new_steward_particular","new_executor_particular","resumed_at_cut","resume_execution_gate_id","resume_evidence_path","status","total_progress_percent","new_work_progress_percent","last_resumed_checkpoint_id","resumed_checkpoint_count","checkpoint_state_authority","ownership_transfer","old_run_rewritten","service_complete","settlement_authority","laws","resume_id","signing"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.execution-resume"},
    "version":{"const":"0"},
    "authority":{"const":"owner-local-resumed-execution"},
    "old_run_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "old_reservation_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "source_checkpoint_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "source_pause_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "source_stop_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "source_partial_result_ref":{"type":"string","minLength":1},
    "prior_progress_percent":{"type":"integer","minimum":1,"maximum":99},
    "remaining_work_percent":{"type":"integer","minimum":1,"maximum":99},
    "source_work_measure":{"type":"object"},
    "prior_work_measure":{"type":"object"},
    "remaining_work_measure":{"type":"object"},
    "new_guild_id":{"type":"string","minLength":1},
    "new_reservation_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "new_authorization_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "new_steward_particular":{"type":"string","minLength":1},
    "new_executor_particular":{"type":"string","minLength":1},
    "resumed_at_cut":{"type":"integer","minimum":0},
    "resume_execution_gate_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "resume_evidence_path":{"type":"string","minLength":1},
    "status":{"const":"RUNNING"},
    "total_progress_percent":{"type":"integer","minimum":1,"maximum":99},
    "new_work_progress_percent":{"const":0},
    "last_resumed_checkpoint_id":{"type":"null"},
    "resumed_checkpoint_count":{"const":0},
    "checkpoint_state_authority":{"const":"none"},
    "ownership_transfer":{"const":false},
    "old_run_rewritten":{"const":false},
    "service_complete":{"const":false},
    "settlement_authority":{"const":"none"},
    "laws":{"type":"array","items":{"type":"string"}},
    "resume_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "signing":{"type":"object"}
  },
  "additionalProperties":false
}