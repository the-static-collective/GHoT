{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-versioned-policy-route-binding.v0.json",
  "title":"GHoT Lightwalker Versioned Policy Route Binding V0",
  "type":"object",
  "required":["kind","version","authority","policy_set_id","promise_id","source_slot_id","route_binding_id","reservation_id","admission_response_id","active_policy_version_ids","bound_at_cut","retroactive_rewrite","authority_carry_forward","reservation_authority","laws","versioned_binding_id"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.versioned-policy-route-binding"},
    "version":{"const":"0"},
    "authority":{"const":"derived-policy-version-route-linkage"},
    "policy_set_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "promise_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "source_slot_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "route_binding_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "reservation_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "admission_response_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "active_policy_version_ids":{"type":"array","minItems":1,"items":{"type":"string"}},
    "bound_at_cut":{"type":"integer","minimum":0},
    "retroactive_rewrite":{"const":false},
    "authority_carry_forward":{"const":false},
    "reservation_authority":{"const":"none"},
    "laws":{"type":"array","items":{"type":"string"}},
    "versioned_binding_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties":false
}