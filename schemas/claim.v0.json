{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/claim.v0.json",
  "title": "GHoT Work Claim V0",
  "type": "object",
  "required": [
    "kind",
    "version",
    "hold_id",
    "lease_id",
    "worker_id",
    "claimed_at",
    "lease_seconds",
    "lease_until"
  ],
  "properties": {
    "kind": { "const": "ghot.claim" },
    "version": { "const": "0" },
    "hold_id": { "type": "string", "minLength": 1 },
    "lease_id": { "type": "string", "minLength": 1 },
    "worker_id": { "type": "string", "minLength": 1 },
    "claimed_at_epoch": { "type": "number" },
    "claimed_at": { "type": "string" },
    "lease_seconds": { "type": "number", "exclusiveMinimum": 0 },
    "lease_until_epoch": { "type": "number" },
    "lease_until": { "type": "string" },
    "parent_energy_plan_id": { "type": ["string", "null"] },
    "recovered_from_lease_id": { "type": ["string", "null"] }
  }
}
