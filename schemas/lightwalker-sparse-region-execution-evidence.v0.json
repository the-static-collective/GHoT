{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-sparse-region-execution-evidence.v0.json",
  "title":"GHoT Lightwalker Sparse Region Execution Evidence V0",
  "type":"object",
  "required":["kind","version","authority","exact_missing_region_set_id","pixel_region_plan_id","work_address","lease_ids","use_ids","close_ids","region_count","region_claims","consumed_work_measure","all_missing_regions_satisfied","region_authority_duplicated","compute_capacity_authority","continuation_authority","settlement_authority","laws","sparse_region_execution_evidence_id"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.sparse-region-execution-evidence"},
    "version":{"const":"0"},
    "authority":{"const":"derived-sparse-region-execution-evidence"},
    "exact_missing_region_set_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "pixel_region_plan_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "work_address":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "lease_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
    "use_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
    "close_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
    "region_count":{"type":"integer","minimum":1},
    "region_claims":{"type":"array","minItems":1,"items":{"type":"object"}},
    "consumed_work_measure":{"type":"object"},
    "all_missing_regions_satisfied":{"const":true},
    "region_authority_duplicated":{"const":false},
    "compute_capacity_authority":{"const":"none"},
    "continuation_authority":{"const":"none"},
    "settlement_authority":{"const":"none"},
    "laws":{"type":"array","items":{"type":"string"}},
    "sparse_region_execution_evidence_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties":false
}