{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-transition-aware-execution-gate.v0.json",
  "title":"GHoT Lightwalker Transition-Aware Execution Gate V0",
  "type":"object",
  "required":[
    "kind","version","authority","promise_id","route_policy_id","source_slot_id",
    "temporal_intersection_id","transition_subject_reservation_id",
    "execution_reservation_id","observed_cut","aggregate_action","evidence_path",
    "revalidation_id","migration_id","current_policy_set_id","permitted",
    "source_evidence_recomputed","temporal_freshness_required",
    "reservation_authority","execution_authority","laws","execution_gate_id"
  ],
  "properties":{
    "kind":{"const":"ghot.lightwalker.transition-aware-execution-gate"},
    "version":{"const":"0"},
    "authority":{"const":"derived-execution-prerequisite-only"},
    "promise_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "route_policy_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "source_slot_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "temporal_intersection_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "transition_subject_reservation_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "execution_reservation_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "observed_cut":{"type":"integer","minimum":0},
    "aggregate_action":{"enum":["LEGACY_PATH_OPEN","REVALIDATION_REQUIRED","MIGRATION_REQUIRED"]},
    "evidence_path":{"enum":["FRESH_LEGACY_PERMISSION","CURRENT_REVALIDATION","VERIFIED_MIGRATION"]},
    "revalidation_id":{"type":["string","null"]},
    "migration_id":{"type":["string","null"]},
    "current_policy_set_id":{"type":["string","null"]},
    "permitted":{"const":true},
    "source_evidence_recomputed":{"const":true},
    "temporal_freshness_required":{"const":true},
    "reservation_authority":{"const":"none"},
    "execution_authority":{"const":"none"},
    "laws":{"type":"array","items":{"type":"string"}},
    "execution_gate_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties":false
}