{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/lightwalker-heterogeneous-offer.v0.json",
  "title": "GHoT Lightwalker Heterogeneous Offer V0",
  "type": "object",
  "required": ["kind","version","authority","offeror_particular","offeror_obligation","acceptor_obligation","orientation_refs","valid_through_cut","laws","offer_id"],
  "properties": {
    "kind": { "const": "ghot.lightwalker.heterogeneous-offer" },
    "version": { "const": "0" },
    "authority": { "const": "offeror-local" },
    "offeror_particular": { "type": "string", "minLength": 1 },
    "offeror_obligation": { "type": "object" },
    "acceptor_obligation": { "type": "object" },
    "orientation_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "valid_through_cut": { "type": "integer", "minimum": 0 },
    "laws": { "type": "array", "items": { "type": "string" } },
    "offer_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
