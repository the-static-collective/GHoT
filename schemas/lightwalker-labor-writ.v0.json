{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/lightwalker-labor-writ.v0.json",
  "title": "GHoT Lightwalker Labor Writ V0",
  "type": "object",
  "required": ["kind","version","authority","issuer_particular","initial_holder_particular","scope","scope_digest","issued_at_cut","expires_after_cut","delegation_policy","redemption_policy","laws","writ_id","signing"],
  "properties": {
    "kind": { "const": "ghot.lightwalker.labor-writ" },
    "version": { "const": "0" },
    "authority": { "const": "issuer-promise-only" },
    "issuer_particular": { "type": "string", "minLength": 1 },
    "initial_holder_particular": { "type": "string", "minLength": 1 },
    "scope": { "type": "object" },
    "scope_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "issued_at_cut": { "type": "integer", "minimum": 0 },
    "expires_after_cut": { "type": "integer", "minimum": 0 },
    "delegation_policy": { "type": "object" },
    "redemption_policy": { "type": "object" },
    "laws": { "type": "array", "items": { "type": "string" } },
    "writ_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "signing": { "type": "object" }
  },
  "additionalProperties": false
}