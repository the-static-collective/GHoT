{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-recursive-continuation-checkpoint.v0.json",
  "title":"GHoT Lightwalker Recursive Continuation Checkpoint V0",
  "type":"object",
  "required":["kind","version","authority","continuation_lineage_id","root_run_id","root_checkpoint_id","parent_node_id","hop_index","reservation_id","steward_particular","executor_particular","ancestor_checkpoint_ids","checkpoint_at_cut","continuation_gate_id","total_progress_percent","cumulative_work_measure","new_work_measure","partial_result_ref","service_complete","settlement_authority","laws","recursive_checkpoint_id","signing"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.recursive-continuation-checkpoint"},
    "version":{"const":"0"},
    "authority":{"const":"owner-local-recursive-checkpoint"},
    "continuation_lineage_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "root_run_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "root_checkpoint_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "parent_node_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "hop_index":{"type":"integer","minimum":2},
    "reservation_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "steward_particular":{"type":"string","minLength":1},
    "executor_particular":{"type":"string","minLength":1},
    "ancestor_checkpoint_ids":{"type":"array","minItems":2,"uniqueItems":true,"items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
    "checkpoint_at_cut":{"type":"integer","minimum":0},
    "continuation_gate_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "total_progress_percent":{"type":"integer","minimum":1,"maximum":99},
    "cumulative_work_measure":{"type":"object"},
    "new_work_measure":{"type":"object"},
    "partial_result_ref":{"type":"string","minLength":1},
    "service_complete":{"const":false},
    "settlement_authority":{"const":"none"},
    "laws":{"type":"array","items":{"type":"string"}},
    "recursive_checkpoint_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "signing":{"type":"object"}
  },
  "additionalProperties":false
}