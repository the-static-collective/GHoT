{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-continuation-handoff.v0.json",
  "title":"GHoT Lightwalker Continuation Handoff V0",
  "type":"object",
  "required":["kind","version","authority","root_run_id","root_checkpoint_id","parent_resume_id","parent_reservation_id","parent_checkpoint_id","parent_stop_id","parent_finalization_id","parent_steward_particular","cumulative_progress_percent","source_work_measure","cumulative_work_measure","remaining_work_measure","next_guild_id","next_reservation_id","next_steward_particular","observed_cut","parent_leaf_closed","execution_authority","ownership_transfer","history_rewritten","laws","continuation_handoff_id","signing"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.continuation-handoff"},
    "version":{"const":"0"},
    "authority":{"const":"owner-local-continuation-handoff"},
    "root_run_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "root_checkpoint_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "parent_resume_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "parent_reservation_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "parent_checkpoint_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "parent_stop_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "parent_finalization_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "parent_steward_particular":{"type":"string","minLength":1},
    "cumulative_progress_percent":{"type":"integer","minimum":1,"maximum":99},
    "source_work_measure":{"type":"object"},
    "cumulative_work_measure":{"type":"object"},
    "remaining_work_measure":{"type":"object"},
    "next_guild_id":{"type":"string","minLength":1},
    "next_reservation_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "next_steward_particular":{"type":"string","minLength":1},
    "observed_cut":{"type":"integer","minimum":0},
    "parent_leaf_closed":{"const":true},
    "execution_authority":{"const":"none"},
    "ownership_transfer":{"const":false},
    "history_rewritten":{"const":false},
    "laws":{"type":"array","items":{"type":"string"}},
    "continuation_handoff_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "signing":{"type":"object"}
  },
  "additionalProperties":false
}