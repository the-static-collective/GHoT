{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/foreign-offer-catalog.v0.json",
  "title": "GHoT Foreign Offer Catalog V0",
  "type": "object",
  "required": ["kind","version","entries","merged_parcels"],
  "properties": {
    "kind": { "const": "ghot.foreign-offer-catalog" },
    "version": { "const": "0" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_particular","source_node_id","capability","available",
          "power_class","parcel_id","payload_address"
        ],
        "properties": {
          "source_particular": { "type": "string", "minLength": 1 },
          "source_node_id": { "type": "string", "minLength": 1 },
          "capability": { "type": "string", "minLength": 1 },
          "available": { "type": "boolean" },
          "power_class": { "type": ["string","null"] },
          "parcel_id": { "type": "string", "minLength": 1 },
          "payload_address": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "merged_parcels": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
