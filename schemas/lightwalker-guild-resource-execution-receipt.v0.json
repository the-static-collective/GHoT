{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/lightwalker-guild-resource-execution-receipt.v0.json",
  "title": "GHoT Lightwalker Guild Resource Execution Receipt V0",
  "type": "object",
  "required": ["kind","version","guild_id","snapshot_id","proposal_id","authorization_id","resource_entry_id","executor_particular","observed_cut","status","success","authorization_spent","consumed_measure","result_ref","error","laws","execution_receipt_id","signing"],
  "properties": {
    "kind": { "const": "ghot.lightwalker.guild-resource-execution-receipt" },
    "version": { "const": "0" },
    "guild_id": { "type": "string", "minLength": 1 },
    "snapshot_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "proposal_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "authorization_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "resource_entry_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "executor_particular": { "type": "string", "minLength": 1 },
    "observed_cut": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["EXECUTED","FAILED"] },
    "success": { "type": "boolean" },
    "authorization_spent": { "const": true },
    "consumed_measure": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["unit","quantity"],
          "properties": {
            "unit": { "type": "string", "minLength": 1 },
            "quantity": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
    "result_ref": { "type": ["string","null"] },
    "error": { "type": ["string","null"] },
    "laws": { "type": "array", "items": { "type": "string" } },
    "execution_receipt_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "signing": { "type": "object" }
  },
  "additionalProperties": false
}