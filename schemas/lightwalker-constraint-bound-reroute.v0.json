{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-constraint-bound-reroute.v0.json",
  "title":"GHoT Lightwalker Constraint-Bound Reroute V0",
  "type":"object",
  "required":["kind","version","authority","promise_id","constraint_evaluation_id","frontier_id","scoring_policy_id","selection_id","scored_binding_id","reroute_id","selected_capacity_guild_id","constraint_override_authority","value_authority","reservation_authority","execution_authority","laws","binding_id"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.constraint-bound-reroute"},
    "version":{"const":"0"},
    "authority":{"const":"derived-constraint-frontier-reroute-linkage"},
    "promise_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "constraint_evaluation_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "frontier_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "scoring_policy_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "selection_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "scored_binding_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "reroute_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "selected_capacity_guild_id":{"type":"string","minLength":1},
    "constraint_override_authority":{"const":"none"},
    "value_authority":{"const":"none"},
    "reservation_authority":{"const":"none"},
    "execution_authority":{"const":"none"},
    "laws":{"type":"array","items":{"type":"string"}},
    "binding_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties":false
}