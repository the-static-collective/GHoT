{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/lightwalker-capacity-backed-service-encumbrance.v0.json",
  "title": "GHoT Lightwalker Capacity-Backed Service Encumbrance V0",
  "type": "object",
  "required": ["kind","version","authority","guild_id","snapshot_id","promise_id","offer_id","acceptance_id","proposal_id","authorization_id","reservation_id","resource_entry_id","steward_particular","reserved_measure","performance_proven","payment_inferred","status","laws","encumbrance_id","signing"],
  "properties": {
    "kind": { "const": "ghot.lightwalker.capacity-backed-service-encumbrance" },
    "version": { "const": "0" },
    "authority": { "const": "guild-local-service-encumbrance" },
    "guild_id": { "type": "string", "minLength": 1 },
    "snapshot_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "promise_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "offer_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "acceptance_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "proposal_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "authorization_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "reservation_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "resource_entry_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "steward_particular": { "type": "string", "minLength": 1 },
    "reserved_measure": {
      "type": "object",
      "required": ["unit","quantity"],
      "properties": {
        "unit": { "type": "string", "minLength": 1 },
        "quantity": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "performance_proven": { "const": false },
    "payment_inferred": { "const": false },
    "status": { "const": "ENCUMBERED" },
    "laws": { "type": "array", "items": { "type": "string" } },
    "encumbrance_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "signing": { "type": "object" }
  },
  "additionalProperties": false
}