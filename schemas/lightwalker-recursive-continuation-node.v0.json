{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-recursive-continuation-node.v0.json",
  "title":"GHoT Lightwalker Recursive Continuation Node V0",
  "type":"object",
  "required":["kind","version","authority","continuation_lineage_id","root_run_id","root_checkpoint_id","parent_node_id","parent_node_kind","parent_checkpoint_id","parent_handoff_id","checkpoint_ancestry","ancestry_digest","hop_index","prior_progress_percent","source_work_measure","prior_work_measure","remaining_work_measure","new_guild_id","new_reservation_id","new_authorization_id","new_steward_particular","new_executor_particular","resumed_at_cut","resume_execution_gate_id","resume_evidence_path","status","service_complete","ownership_transfer","ancestor_work_reexecuted","settlement_authority","laws","recursive_node_id","signing"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.recursive-continuation-node"},
    "version":{"const":"0"},
    "authority":{"const":"owner-local-recursive-continuation"},
    "continuation_lineage_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "root_run_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "root_checkpoint_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "parent_node_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "parent_node_kind":{"type":"string","minLength":1},
    "parent_checkpoint_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "parent_handoff_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "checkpoint_ancestry":{"type":"array","minItems":3,"uniqueItems":true,"items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
    "ancestry_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "hop_index":{"type":"integer","minimum":3},
    "prior_progress_percent":{"type":"integer","minimum":1,"maximum":99},
    "source_work_measure":{"type":"object"},
    "prior_work_measure":{"type":"object"},
    "remaining_work_measure":{"type":"object"},
    "new_guild_id":{"type":"string","minLength":1},
    "new_reservation_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "new_authorization_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "new_steward_particular":{"type":"string","minLength":1},
    "new_executor_particular":{"type":"string","minLength":1},
    "resumed_at_cut":{"type":"integer","minimum":0},
    "resume_execution_gate_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "resume_evidence_path":{"type":"string","minLength":1},
    "status":{"const":"RUNNING"},
    "service_complete":{"const":false},
    "ownership_transfer":{"const":false},
    "ancestor_work_reexecuted":{"const":false},
    "settlement_authority":{"const":"none"},
    "laws":{"type":"array","items":{"type":"string"}},
    "recursive_node_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "signing":{"type":"object"}
  },
  "additionalProperties":false
}