{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-temporal-policy-intersection.v0.json",
  "title":"GHoT Lightwalker Temporal Policy Intersection V0",
  "type":"object",
  "required":[
    "kind","version","authority","promise_id","route_policy_id","source_slot_id",
    "reservation_id","observed_cut","execution_started_at_cut","transition_ids",
    "temporal_provenance","result","aggregate_action","legacy_path_open",
    "revalidation_required","migration_required","enforcement_deferred_until_cut",
    "blocking_transition_ids","conflicts","source_transitions_rewritten",
    "mode_override_authority","relaxation_authority","reservation_authority",
    "execution_authority","laws","temporal_intersection_id"
  ],
  "properties":{
    "kind":{"const":"ghot.lightwalker.temporal-policy-intersection"},
    "version":{"const":"0"},
    "authority":{"const":"derived-temporal-intersection-only"},
    "promise_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "route_policy_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "source_slot_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "reservation_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "observed_cut":{"type":"integer","minimum":0},
    "execution_started_at_cut":{"type":["integer","null"],"minimum":0},
    "transition_ids":{"type":"array","minItems":2,"items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
    "temporal_provenance":{"type":"array","minItems":2,"items":{"type":"object"}},
    "result":{"enum":["COMMON_PATH","NO_COMMON_TRANSITION_PATH"]},
    "aggregate_action":{"enum":["LEGACY_PATH_OPEN","REVALIDATION_REQUIRED","MIGRATION_REQUIRED","NO_COMMON_TRANSITION_PATH"]},
    "legacy_path_open":{"type":"boolean"},
    "revalidation_required":{"type":"boolean"},
    "migration_required":{"type":"boolean"},
    "enforcement_deferred_until_cut":{"type":["integer","null"],"minimum":0},
    "blocking_transition_ids":{"type":"array","items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
    "conflicts":{"type":"array","items":{"type":"string"}},
    "source_transitions_rewritten":{"const":false},
    "mode_override_authority":{"const":"none"},
    "relaxation_authority":{"const":"none"},
    "reservation_authority":{"const":"none"},
    "execution_authority":{"const":"none"},
    "laws":{"type":"array","items":{"type":"string"}},
    "temporal_intersection_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties":false
}