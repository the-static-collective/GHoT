{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-execution-pause.v0.json",
  "title":"GHoT Lightwalker Execution Pause V0",
  "type":"object",
  "required":["kind","version","authority","run_id","reservation_id","steward_particular","paused_at_cut","reason","progress_percent","last_checkpoint_id","partial_result_ref","failure","service_complete","reservation_released","history_rewritten","settlement_authority","laws","pause_id","signing"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.execution-pause"},
    "version":{"const":"0"},
    "authority":{"const":"owner-local-execution-pause"},
    "run_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "reservation_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "steward_particular":{"type":"string","minLength":1},
    "paused_at_cut":{"type":"integer","minimum":0},
    "reason":{"type":"string","minLength":1},
    "progress_percent":{"type":"integer","minimum":0,"maximum":100},
    "last_checkpoint_id":{"type":["string","null"]},
    "partial_result_ref":{"type":["string","null"]},
    "failure":{"const":false},
    "service_complete":{"const":false},
    "reservation_released":{"const":false},
    "history_rewritten":{"const":false},
    "settlement_authority":{"const":"none"},
    "laws":{"type":"array","items":{"type":"string"}},
    "pause_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "signing":{"type":"object"}
  },
  "additionalProperties":false
}