{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-resumed-execution-checkpoint.v0.json",
  "title":"GHoT Lightwalker Resumed Execution Checkpoint V0",
  "type":"object",
  "required":["kind","version","authority","resume_id","old_run_id","source_checkpoint_id","source_partial_result_ref","new_reservation_id","new_steward_particular","new_executor_particular","checkpoint_index","previous_resumed_checkpoint_id","checkpoint_at_cut","continuation_gate_id","continuation_evidence_path","prior_progress_percent","new_work_progress_percent","total_progress_percent","partial_result_ref","service_complete","settlement_authority","prior_work_reexecuted","laws","resumed_checkpoint_id","signing"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.resumed-execution-checkpoint"},
    "version":{"const":"0"},
    "authority":{"const":"owner-local-resumed-checkpoint"},
    "resume_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "old_run_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "source_checkpoint_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "source_partial_result_ref":{"type":"string","minLength":1},
    "new_reservation_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "new_steward_particular":{"type":"string","minLength":1},
    "new_executor_particular":{"type":"string","minLength":1},
    "checkpoint_index":{"type":"integer","minimum":1},
    "previous_resumed_checkpoint_id":{"type":["string","null"]},
    "checkpoint_at_cut":{"type":"integer","minimum":0},
    "continuation_gate_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "continuation_evidence_path":{"type":"string","minLength":1},
    "prior_progress_percent":{"type":"integer","minimum":1,"maximum":99},
    "new_work_progress_percent":{"type":"integer","minimum":1,"maximum":99},
    "total_progress_percent":{"type":"integer","minimum":1,"maximum":99},
    "partial_result_ref":{"type":"string","minLength":1},
    "service_complete":{"const":false},
    "settlement_authority":{"const":"none"},
    "prior_work_reexecuted":{"const":false},
    "laws":{"type":"array","items":{"type":"string"}},
    "resumed_checkpoint_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "signing":{"type":"object"}
  },
  "additionalProperties":false
}