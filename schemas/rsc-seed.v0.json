{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.example/schemas/rsc-seed.v0.json",
  "title": "RSC Seed v0",
  "type": "object",
  "required": ["kind", "version", "artifacts", "crossings"],
  "properties": {
    "kind": {"const": "rsc.seed"},
    "version": {"const": "0"},
    "title": {"type": "string"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "current_role", "primitives", "migratable_parts", "boundaries"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "source": {"type": "string"},
          "current_role": {"type": "string", "minLength": 1},
          "primitives": {"type": "array"},
          "migratable_parts": {"type": "array"},
          "boundaries": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "crossings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "proposal", "exaptation", "evidence", "boundary_checks", "experiment"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "from": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "to": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "proposal": {"type": "string", "minLength": 1},
          "exaptation": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "preserves": {"type": "array", "items": {"type": "string"}},
          "boundary_checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["law", "status"],
              "properties": {
                "law": {"type": "string"},
                "status": {"enum": ["pass", "hold"]},
                "note": {"type": "string"}
              }
            }
          },
          "readiness": {"enum": ["ready", "hold"]},
          "experiment": {
            "type": "object",
            "required": ["title", "cost", "reversible", "requires", "produces"],
            "properties": {
              "title": {"type": "string"},
              "cost": {"enum": ["small", "medium", "large"]},
              "reversible": {"type": "boolean"},
              "requires": {"type": "array"},
              "produces": {"type": "array"}
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
