{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/lightwalker-distributed-reservation-claim.v0.json",
  "title": "GHoT Lightwalker Distributed Reservation Claim V0",
  "type": "object",
  "required": ["kind","version","authority","guild_id","snapshot_id","resource_entry_id","resource_subject_ref","proposal_id","node_id","node_particular","executor_particular","claimed_measure","claimed_at_cut","expires_after_cut","known_claim_ids","status","laws","claim_id","signing"],
  "properties": {
    "kind": { "const": "ghot.lightwalker.distributed-reservation-claim" },
    "version": { "const": "0" },
    "authority": { "const": "node-local-tentative-claim" },
    "guild_id": { "type": "string", "minLength": 1 },
    "snapshot_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "resource_entry_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "resource_subject_ref": { "type": "string", "minLength": 1 },
    "proposal_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "node_id": { "type": "string", "minLength": 1 },
    "node_particular": { "type": "string", "minLength": 1 },
    "executor_particular": { "type": "string", "minLength": 1 },
    "claimed_measure": {
      "type": "object",
      "required": ["unit","quantity"],
      "properties": {
        "unit": { "type": "string", "minLength": 1 },
        "quantity": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "claimed_at_cut": { "type": "integer", "minimum": 0 },
    "expires_after_cut": { "type": "integer", "minimum": 0 },
    "known_claim_ids": { "type": "array", "items": { "type": "string" } },
    "status": { "const": "LOCAL_TENTATIVE" },
    "laws": { "type": "array", "items": { "type": "string" } },
    "claim_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "signing": { "type": "object" }
  },
  "additionalProperties": false
}