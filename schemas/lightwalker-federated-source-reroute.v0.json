{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-federated-source-reroute.v0.json",
  "title":"GHoT Lightwalker Federated Source Reroute V0",
  "type":"object",
  "required":["kind","version","authority","promisor_particular","promise_id","offer_id","acceptance_id","original_source_id","original_capacity_guild_id","original_grant_id","original_reservation_id","original_finalization_id","original_route_status","substitute_capacity_guild_id","substitute_snapshot_id","substitute_remote_proof_id","substitute_resource_entry_id","replacement_measure","rerouted_at_cut","promise_rewritten","ownership_transfer","old_authority_counts","substitute_reserved","laws","reroute_id","signing"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.federated-source-reroute"},
    "version":{"const":"0"},
    "authority":{"const":"promisor-route-substitution-only"},
    "promisor_particular":{"type":"string","minLength":1},
    "promise_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "offer_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "acceptance_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "original_source_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "original_capacity_guild_id":{"type":"string","minLength":1},
    "original_grant_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "original_reservation_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "original_finalization_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "original_route_status":{"const":"RELEASED"},
    "substitute_capacity_guild_id":{"type":"string","minLength":1},
    "substitute_snapshot_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "substitute_remote_proof_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "substitute_resource_entry_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "replacement_measure":{"type":"object"},
    "rerouted_at_cut":{"type":"integer","minimum":0},
    "promise_rewritten":{"const":false},
    "ownership_transfer":{"const":false},
    "old_authority_counts":{"const":false},
    "substitute_reserved":{"const":false},
    "laws":{"type":"array","items":{"type":"string"}},
    "reroute_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "signing":{"type":"object"}
  },
  "additionalProperties":false
}