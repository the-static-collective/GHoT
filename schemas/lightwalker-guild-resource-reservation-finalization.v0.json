{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/lightwalker-guild-resource-reservation-finalization.v0.json",
  "title": "GHoT Lightwalker Guild Reservation Finalization V0",
  "type": "object",
  "required": [
    "kind",
    "version",
    "reservation_id",
    "authorization_id",
    "snapshot_id",
    "resource_entry_id",
    "steward_particular",
    "status",
    "reason",
    "observed_cut",
    "execution_receipt_id",
    "partial_evidence_ref",
    "consumed_measure",
    "released_measure",
    "laws",
    "finalization_id",
    "signing"
  ],
  "properties": {
    "kind": {
      "const": "ghot.lightwalker.guild-resource-reservation-finalization"
    },
    "version": {
      "const": "0"
    },
    "reservation_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "authorization_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "resource_entry_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "steward_particular": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "CONSUMED",
        "RELEASED",
        "PARTIALLY_CONSUMED"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "observed_cut": {
      "type": "integer",
      "minimum": 0
    },
    "execution_receipt_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "consumed_measure": {
      "type": [
        "object",
        "null"
      ]
    },
    "released_measure": {
      "type": [
        "object",
        "null"
      ]
    },
    "laws": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "finalization_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signing": {
      "type": "object"
    },
    "partial_evidence_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
