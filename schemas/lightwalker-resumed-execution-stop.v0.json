{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-resumed-execution-stop.v0.json",
  "title":"GHoT Lightwalker Resumed Execution Stop V0",
  "type":"object",
  "required":["kind","version","authority","resume_id","old_run_id","source_checkpoint_id","new_reservation_id","new_steward_particular","stopped_at_cut","reason","prior_progress_percent","total_progress_percent","last_resumed_checkpoint_id","partial_result_ref","reservation_finalization_id","reservation_status","service_complete","history_rewritten","settlement_authority","laws","resumed_stop_id","signing"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.resumed-execution-stop"},
    "version":{"const":"0"},
    "authority":{"const":"owner-local-resumed-execution-stop"},
    "resume_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "old_run_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "source_checkpoint_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "new_reservation_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "new_steward_particular":{"type":"string","minLength":1},
    "stopped_at_cut":{"type":"integer","minimum":0},
    "reason":{"type":"string","minLength":1},
    "prior_progress_percent":{"type":"integer","minimum":0,"maximum":99},
    "total_progress_percent":{"type":"integer","minimum":0,"maximum":99},
    "last_resumed_checkpoint_id":{"type":["string","null"]},
    "partial_result_ref":{"type":["string","null"]},
    "reservation_finalization_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "reservation_status":{"enum":["RELEASED","PARTIALLY_CONSUMED"]},
    "service_complete":{"const":false},
    "history_rewritten":{"const":false},
    "settlement_authority":{"const":"none"},
    "laws":{"type":"array","items":{"type":"string"}},
    "resumed_stop_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "signing":{"type":"object"}
  },
  "additionalProperties":false
}