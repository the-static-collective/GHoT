{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-recursive-branch-fork.v0.json",
  "title":"GHoT Lightwalker Recursive Branch Fork V0",
  "type":"object",
  "required":["kind","version","authority","continuation_lineage_id","root_run_id","root_checkpoint_id","parent_node_id","parent_hop_index","parent_checkpoint_id","parent_steward_particular","branches","status","global_consensus","history_deleted","execution_authority","laws","recursive_branch_fork_id"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.recursive-branch-fork"},
    "version":{"const":"0"},
    "authority":{"const":"derived-recursive-branch-fork-observation"},
    "continuation_lineage_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "root_run_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "root_checkpoint_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "parent_node_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "parent_hop_index":{"type":"integer","minimum":2},
    "parent_checkpoint_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "parent_steward_particular":{"type":"string","minLength":1},
    "branches":{"type":"array","minItems":1,"items":{"type":"object","required":["recursive_handoff_id","child_node_id","child_guild_id","child_reservation_id"],"properties":{"recursive_handoff_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"child_node_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"child_guild_id":{"type":"string","minLength":1},"child_reservation_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},"additionalProperties":false}},
    "status":{"enum":["FORK","NO_FORK"]},
    "global_consensus":{"const":false},
    "history_deleted":{"const":false},
    "execution_authority":{"const":"none"},
    "laws":{"type":"array","items":{"type":"string"}},
    "recursive_branch_fork_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties":false
}