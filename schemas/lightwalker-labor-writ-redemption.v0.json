{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/lightwalker-labor-writ-redemption.v0.json",
  "title": "GHoT Lightwalker Labor Writ Redemption V0",
  "type": "object",
  "required": ["kind","version","writ_id","redeemer_particular","requested_at_cut","delegation_id","scope_digest","nonce","laws","redemption_request_id","signing"],
  "properties": {
    "kind": { "const": "ghot.lightwalker.labor-writ-redemption-request" },
    "version": { "const": "0" },
    "writ_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "redeemer_particular": { "type": "string", "minLength": 1 },
    "requested_at_cut": { "type": "integer", "minimum": 0 },
    "delegation_id": { "type": ["string","null"] },
    "scope_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "nonce": { "type": "string", "minLength": 1 },
    "laws": { "type": "array", "items": { "type": "string" } },
    "redemption_request_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "signing": { "type": "object" }
  },
  "additionalProperties": false
}