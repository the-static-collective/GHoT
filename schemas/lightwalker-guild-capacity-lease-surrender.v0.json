{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/lightwalker-guild-capacity-lease-surrender.v0.json",
  "title": "GHoT Lightwalker Guild Capacity Lease Surrender V0",
  "type": "object",
  "required": ["kind","version","authority","guild_id","snapshot_id","resource_entry_id","parent_lease_id","source_node_particular","unit","leased_quantity","consumed_before_surrender","remaining_before_surrender","allocations","allocated_quantity","returned_to_guild_quantity","use_ids","observed_cut","status","laws","surrender_id","signing"],
  "properties": {
    "kind": { "const": "ghot.lightwalker.guild-capacity-lease-surrender" },
    "version": { "const": "0" },
    "authority": { "const": "holder-surrender-of-remaining-authority" },
    "guild_id": { "type": "string", "minLength": 1 },
    "snapshot_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "resource_entry_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "parent_lease_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "source_node_particular": { "type": "string", "minLength": 1 },
    "unit": { "type": "string", "minLength": 1 },
    "leased_quantity": { "type": "integer", "minimum": 1 },
    "consumed_before_surrender": { "type": "integer", "minimum": 0 },
    "remaining_before_surrender": { "type": "integer", "minimum": 0 },
    "allocations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["target_node_id","target_node_particular","quantity"],
        "properties": {
          "target_node_id": { "type": "string", "minLength": 1 },
          "target_node_particular": { "type": "string", "minLength": 1 },
          "quantity": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "allocated_quantity": { "type": "integer", "minimum": 1 },
    "returned_to_guild_quantity": { "type": "integer", "minimum": 0 },
    "use_ids": { "type": "array", "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } },
    "observed_cut": { "type": "integer", "minimum": 0 },
    "status": { "const": "SURRENDERED" },
    "laws": { "type": "array", "items": { "type": "string" } },
    "surrender_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "signing": { "type": "object" }
  },
  "additionalProperties": false
}