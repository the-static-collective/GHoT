{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/task.v0.json",
  "title": "GHoT Task V0",
  "type": "object",
  "required": ["kind", "version", "task_id", "capability", "created_at", "input"],
  "properties": {
    "kind": { "const": "ghot.task" },
    "version": { "const": "0" },
    "task_id": { "type": "string", "minLength": 1 },
    "capability": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string" },
    "requester_node_id": { "type": ["string", "null"] },
    "input": {},
    "constraints": { "type": "object" }
  }
}
