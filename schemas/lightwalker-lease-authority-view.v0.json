{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/lightwalker-lease-authority-view.v0.json",
  "title": "GHoT Lightwalker Lease Authority View V0",
  "type": "object",
  "required": ["kind","version","authority","dag_id","history_digest","root_lease_id","observed_cut","live_leaves","expired_leaves","totals","history_retained_by_digest","laws","view_id"],
  "properties": {
    "kind": { "const": "ghot.lightwalker.lease-authority-view" },
    "version": { "const": "0" },
    "authority": { "const": "derived-current-authority-view" },
    "dag_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "history_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "root_lease_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "observed_cut": { "type": "integer", "minimum": 0 },
    "live_leaves": { "type": "array", "items": { "type": "object" } },
    "expired_leaves": { "type": "array", "items": { "type": "object" } },
    "totals": { "type": "object" },
    "history_retained_by_digest": { "const": true },
    "laws": { "type": "array", "items": { "type": "string" } },
    "view_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}