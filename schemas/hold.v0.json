{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/hold.v0.json",
  "title": "GHoT Hold V0",
  "type": "object",
  "required": [
    "kind",
    "version",
    "hold_id",
    "energy_plan_id",
    "created_at",
    "requester_node_id",
    "capability",
    "urgency",
    "deferrable",
    "reason",
    "release_condition",
    "status"
  ],
  "properties": {
    "kind": { "const": "ghot.hold" },
    "version": { "const": "0" },
    "hold_id": { "type": "string", "minLength": 1 },
    "energy_plan_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string" },
    "expires_at_epoch": { "type": ["number", "null"] },
    "expires_at": { "type": ["string", "null"] },
    "requester_node_id": { "type": "string", "minLength": 1 },
    "capability": { "type": "string", "minLength": 1 },
    "payload": {},
    "urgency": { "enum": ["immediate", "normal", "background"] },
    "deferrable": { "type": "boolean" },
    "data_node_id": { "type": ["string", "null"] },
    "prefer_surplus_for_background": { "type": ["boolean", "null"] },
    "reason": { "type": "string" },
    "release_condition": { "type": "string" },
    "status": { "enum": ["held", "released", "cancelled", "expired"] },
    "evaluation_count": { "type": "integer", "minimum": 0 },
    "last_evaluated_at": { "type": ["string", "null"] },
    "last_child_energy_plan_id": { "type": ["string", "null"] },
    "last_recheck_reason": { "type": ["string", "null"] },
    "released_at": { "type": ["string", "null"] },
    "released_energy_plan_id": { "type": ["string", "null"] },
    "released_receipt_id": { "type": ["string", "null"] },
    "cancelled_at": { "type": ["string", "null"] },
    "cancellation_reason": { "type": ["string", "null"] },
    "expired_at": { "type": ["string", "null"] },
    "updated_at": { "type": ["string", "null"] }
  }
}
