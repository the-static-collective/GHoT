{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-pixel-region-plan.v0.json",
  "title":"GHoT Lightwalker Pixel Region Plan V0",
  "type":"object",
  "required":["kind","version","authority","continuation_lineage_id","work_address","region_semantics","width","height","region_count","regions","operational_accounting_policy","execution_authority","settlement_authority","laws","pixel_region_plan_id"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.pixel-region-plan"},
    "version":{"const":"0"},
    "authority":{"const":"derived-root-work-region-plan"},
    "continuation_lineage_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "work_address":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "region_semantics":{"const":"one-canonical-render-pixel"},
    "width":{"type":"integer","minimum":1},
    "height":{"type":"integer","minimum":1},
    "region_count":{"type":"integer","minimum":1},
    "regions":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"object","required":["work_address","index","x","y","region_id"],"properties":{"work_address":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"index":{"type":"integer","minimum":0},"x":{"type":"integer","minimum":0},"y":{"type":"integer","minimum":0},"region_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},"additionalProperties":false}},
    "operational_accounting_policy":{"type":"object","required":["scope","unit","quantity_per_region"]},
    "execution_authority":{"const":"none"},
    "settlement_authority":{"const":"none"},
    "laws":{"type":"array","items":{"type":"string"}},
    "pixel_region_plan_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties":false
}