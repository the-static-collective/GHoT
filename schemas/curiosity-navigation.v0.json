{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/curiosity-navigation.v0.json",
  "title": "GHoT Curiosity Navigation V0",
  "type": "object",
  "oneOf": [
    {
      "required": [
        "kind","label","owner_contract","href","method","effect",
        "executes","permission_transfer"
      ],
      "properties": {
        "kind": { "const": "evidence-link" },
        "label": { "type": "string", "minLength": 1 },
        "owner_contract": { "type": "string", "minLength": 1 },
        "href": { "type": "string", "pattern": "^/" },
        "method": { "const": "GET" },
        "effect": { "const": "none" },
        "executes": { "const": false },
        "permission_transfer": { "const": false }
      }
    },
    {
      "required": [
        "kind","label","owner_contract","argv","display_command",
        "effect_if_run","executes","permission_transfer"
      ],
      "properties": {
        "kind": { "const": "command-intent" },
        "label": { "type": "string", "minLength": 1 },
        "owner_contract": { "type": "string", "minLength": 1 },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "display_command": { "type": "string", "minLength": 1 },
        "effect_if_run": { "type": "string", "minLength": 1 },
        "executes": { "const": false },
        "permission_transfer": { "const": false }
      },
      "not": { "required": ["href"] }
    }
  ]
}
