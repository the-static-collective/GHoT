{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/offer.v0.json",
  "title": "GHoT Offer V0",
  "type": "object",
  "required": ["kind", "version", "capability", "available"],
  "properties": {
    "kind": { "const": "ghot.offer" },
    "version": { "const": "0" },
    "node_id": { "type": ["string", "null"] },
    "capability": { "type": "string", "minLength": 1 },
    "observed_at": { "type": ["string", "null"] },
    "available": { "type": "boolean" },
    "executor": { "type": ["string", "null"] },
    "context_posture": { "enum": ["fresh", "bounded-window", "lineage-enabled", "owner-local", null] },
    "limits": { "type": "object" },
    "cost": { "type": "object" },
    "policy": { "type": "object" },
    "power": {
      "type": "object",
      "properties": {
        "class": { "enum": ["essential", "light", "medium", "heavy"] },
        "willingness": { "enum": ["abundant", "normal", "conserve", "critical"] },
        "policy_reasons": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
