{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/offer.v0.json",
  "title": "GHoT Offer V0",
  "type": "object",
  "required": ["kind", "version", "node_id", "capability", "observed_at", "available"],
  "properties": {
    "kind": { "const": "ghot.offer" },
    "version": { "const": "0" },
    "node_id": { "type": "string", "minLength": 1 },
    "capability": { "type": "string", "minLength": 1 },
    "observed_at": { "type": "string" },
    "available": { "type": "boolean" },
    "executor": { "type": ["string", "null"] },
    "limits": { "type": "object" },
    "cost": { "type": "object" },
    "policy": { "type": "object" }
  }
}
