{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-composed-policy-bound-reroute.v0.json",
  "title":"GHoT Lightwalker Composed Policy Bound Reroute V0",
  "type":"object",
  "required":["kind","version","authority","promise_id","intersection_id","evaluation_id","frontier_id","scoring_policy_id","selection_id","scored_binding_id","reroute_id","selected_capacity_guild_id","policy_ids","policy_provenance","source_policies_rewritten","override_authority","relaxation_authority","reservation_authority","execution_authority","laws","binding_id"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.composed-policy-bound-reroute"},
    "version":{"const":"0"},
    "authority":{"const":"derived-composed-policy-reroute-linkage"},
    "promise_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "intersection_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "evaluation_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "frontier_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "scoring_policy_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "selection_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "scored_binding_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "reroute_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "selected_capacity_guild_id":{"type":"string","minLength":1},
    "policy_ids":{"type":"array","minItems":2,"items":{"type":"string"}},
    "policy_provenance":{"type":"array","minItems":2,"items":{"type":"object"}},
    "source_policies_rewritten":{"const":false},
    "override_authority":{"const":"none"},
    "relaxation_authority":{"const":"none"},
    "reservation_authority":{"const":"none"},
    "execution_authority":{"const":"none"},
    "laws":{"type":"array","items":{"type":"string"}},
    "binding_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties":false
}