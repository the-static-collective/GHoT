{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-federated-service-promise.v0.json",
  "title":"GHoT Lightwalker Federated Service Promise V0",
  "type":"object",
  "required":["kind","version","authority","promisor_particular","offer_id","service_obligation_id","remote_proof_id","capacity_guild_id","remote_snapshot_id","remote_resource_entry_id","capacity_steward_particular","promised_measure","promised_at_cut","valid_through_cut","capacity_reserved","local_execution_authority","ownership_transfer","laws","promise_id","signing"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.federated-service-promise"},
    "version":{"const":"0"},
    "authority":{"const":"promisor-economic-promise-only"},
    "promisor_particular":{"type":"string","minLength":1},
    "offer_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "service_obligation_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "remote_proof_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "capacity_guild_id":{"type":"string","minLength":1},
    "remote_snapshot_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "remote_resource_entry_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "capacity_steward_particular":{"type":"string","minLength":1},
    "promised_measure":{"type":"object"},
    "promised_at_cut":{"type":"integer","minimum":0},
    "valid_through_cut":{"type":"integer","minimum":0},
    "capacity_reserved":{"const":false},
    "local_execution_authority":{"const":false},
    "ownership_transfer":{"const":false},
    "laws":{"type":"array","items":{"type":"string"}},
    "promise_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "signing":{"type":"object"}
  },
  "additionalProperties":false
}