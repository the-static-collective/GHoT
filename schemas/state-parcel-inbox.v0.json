{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/state-parcel-inbox.v0.json",
  "title": "GHoT State Parcel Inbox Record V0",
  "type": "object",
  "required": [
    "kind","version","parcel_id","parcel_address","payload_address",
    "crossing_id","source_particular","target_particular","status",
    "received_at","updated_at","materialized_ref","decision_note"
  ],
  "properties": {
    "kind": { "const": "ghot.state.parcel.inbox" },
    "version": { "const": "0" },
    "parcel_id": { "type": "string", "minLength": 1 },
    "parcel_address": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "payload_address": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "crossing_id": { "type": "string", "minLength": 1 },
    "source_particular": { "type": "string", "minLength": 1 },
    "target_particular": { "type": ["string","null"] },
    "status": { "enum": ["HOLD","ADMIT","REJECT","SCAR"] },
    "received_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "materialized_ref": { "type": ["string","null"] },
    "decision_note": { "type": ["string","null"] }
  }
}
