{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-recursive-continuation-completion.v0.json",
  "title":"GHoT Lightwalker Recursive Continuation Completion V0",
  "type":"object",
  "required":["kind","version","authority","continuation_lineage_id","recursive_node_id","root_run_id","root_checkpoint_id","checkpoint_ancestry","ancestry_digest","hop_count","new_steward_particular","new_reservation_id","completed_at_cut","completion_gate_id","source_work_measure","ancestor_work_measure","new_work_measure","total_work_measure","total_progress_percent","result_ref","execution_receipt_id","reservation_finalization_id","reservation_status","ancestor_work_reexecuted","ancestor_work_double_counted","full_ancestry_proven","service_complete","ownership_transfer","settlement_authority","laws","recursive_completion_id","signing"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.recursive-continuation-completion"},
    "version":{"const":"0"},
    "authority":{"const":"owner-local-recursive-continuation-completion"},
    "continuation_lineage_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "recursive_node_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "root_run_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "root_checkpoint_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "checkpoint_ancestry":{"type":"array","minItems":3,"uniqueItems":true,"items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
    "ancestry_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "hop_count":{"type":"integer","minimum":3},
    "new_steward_particular":{"type":"string","minLength":1},
    "new_reservation_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "completed_at_cut":{"type":"integer","minimum":0},
    "completion_gate_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "source_work_measure":{"type":"object"},
    "ancestor_work_measure":{"type":"object"},
    "new_work_measure":{"type":"object"},
    "total_work_measure":{"type":"object"},
    "total_progress_percent":{"const":100},
    "result_ref":{"type":"string","minLength":1},
    "execution_receipt_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "reservation_finalization_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "reservation_status":{"const":"CONSUMED"},
    "ancestor_work_reexecuted":{"const":false},
    "ancestor_work_double_counted":{"const":false},
    "full_ancestry_proven":{"const":true},
    "service_complete":{"const":true},
    "ownership_transfer":{"const":false},
    "settlement_authority":{"const":"none"},
    "laws":{"type":"array","items":{"type":"string"}},
    "recursive_completion_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "signing":{"type":"object"}
  },
  "additionalProperties":false
}