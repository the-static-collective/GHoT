{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/composition-want.v0.json",
  "title": "GHoT Composition Want V0",
  "type": "object",
  "required": [
    "kind","version","want_id","gap_id","parcel_id","parcel_address",
    "payload_address","admitted_ref","source","candidates",
    "created_at","note"
  ],
  "properties": {
    "kind": { "const": "ghot.composition.want" },
    "version": { "const": "0" },
    "want_id": { "type": "string", "minLength": 1 },
    "gap_id": { "type": "string", "minLength": 1 },
    "parcel_id": { "type": "string", "minLength": 1 },
    "parcel_address": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "payload_address": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "admitted_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "source": {
      "type": "object",
      "required": ["state_kind","state_version","selector","payload_type"]
    },
    "candidates": { "type": "array", "items": { "type": "object" } },
    "created_at": { "type": "string" },
    "note": { "type": ["string","null"] }
  }
}
