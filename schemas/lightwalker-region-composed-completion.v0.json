{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-region-composed-completion.v0.json",
  "title":"GHoT Lightwalker Region Composed Completion V0",
  "type":"object",
  "required":["kind","version","authority","pixel_region_plan_id","continuation_lineage_id","work_address","canonical_render_address","region_count","pre_fork_credited_region_count","winning_branch_credited_region_count","salvaged_region_credited_count","terminal_executed_region_count","authoritative_region_coverage_count","losing_branch_observed_region_count","losing_branch_overlap_region_count","useful_region_work_observed","salvaged_regions_reexecuted","root_region_double_counted","work_complete","execution_merged","continuation_authority","settlement_authority","laws","region_composed_completion_id"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.region-composed-completion"},
    "version":{"const":"0"},
    "authority":{"const":"derived-exact-region-completion"},
    "pixel_region_plan_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "continuation_lineage_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "work_address":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "canonical_render_address":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "region_count":{"type":"integer","minimum":1},
    "pre_fork_credited_region_count":{"type":"integer","minimum":0},
    "winning_branch_credited_region_count":{"type":"integer","minimum":0},
    "salvaged_region_credited_count":{"type":"integer","minimum":0},
    "terminal_executed_region_count":{"type":"integer","minimum":0},
    "authoritative_region_coverage_count":{"type":"integer","minimum":1},
    "losing_branch_observed_region_count":{"type":"integer","minimum":0},
    "losing_branch_overlap_region_count":{"type":"integer","minimum":0},
    "useful_region_work_observed":{"type":"integer","minimum":1},
    "salvaged_regions_reexecuted":{"const":0},
    "root_region_double_counted":{"const":false},
    "work_complete":{"const":true},
    "execution_merged":{"const":false},
    "continuation_authority":{"const":"none"},
    "settlement_authority":{"const":"none"},
    "laws":{"type":"array","items":{"type":"string"}},
    "region_composed_completion_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties":false
}