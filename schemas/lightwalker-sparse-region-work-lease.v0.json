{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-sparse-region-work-lease.v0.json",
  "title":"GHoT Lightwalker Sparse Region Work Lease V0",
  "type":"object",
  "required":["kind","version","authority","exact_missing_region_set_id","pixel_region_plan_id","continuation_lineage_id","work_address","accepted_coverage_digest","missing_region_set_digest","assigner_particular","node_id","node_particular","assigned_region_count","assigned_region_ids","region_set_digest","assigned_work_measure","issued_at_cut","expires_after_cut","status","compute_capacity_authority","ownership_transfer","settlement_authority","laws","sparse_region_lease_id","signing"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.sparse-region-work-lease"},
    "version":{"const":"0"},
    "authority":{"const":"owner-local-sparse-region-assignment"},
    "exact_missing_region_set_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "pixel_region_plan_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "continuation_lineage_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "work_address":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "accepted_coverage_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "missing_region_set_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "assigner_particular":{"type":"string","minLength":1},
    "node_id":{"type":"string","minLength":1},
    "node_particular":{"type":"string","minLength":1},
    "assigned_region_count":{"type":"integer","minimum":1},
    "assigned_region_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
    "region_set_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "assigned_work_measure":{"type":"object"},
    "issued_at_cut":{"type":"integer","minimum":0},
    "expires_after_cut":{"type":"integer","minimum":0},
    "status":{"const":"ACTIVE"},
    "compute_capacity_authority":{"const":"none"},
    "ownership_transfer":{"const":false},
    "settlement_authority":{"const":"none"},
    "laws":{"type":"array","items":{"type":"string"}},
    "sparse_region_lease_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "signing":{"type":"object"}
  },
  "additionalProperties":false
}