{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-exact-missing-region-set.v0.json",
  "title":"GHoT Lightwalker Exact Missing Region Set V0",
  "type":"object",
  "required":["kind","version","authority","pixel_region_plan_id","continuation_lineage_id","work_address","parent_checkpoint_id","recursive_branch_resolution_id","salvaged_region_admission_id","assignment_owner_particular","accepted_region_count","accepted_region_ids","accepted_coverage_digest","missing_region_count","missing_region_ids","missing_region_set_digest","missing_work_measure","assignment_authority","execution_authority","settlement_authority","laws","exact_missing_region_set_id"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.exact-missing-region-set"},
    "version":{"const":"0"},
    "authority":{"const":"derived-exact-missing-work-observation"},
    "pixel_region_plan_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "continuation_lineage_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "work_address":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "parent_checkpoint_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "recursive_branch_resolution_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "salvaged_region_admission_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "assignment_owner_particular":{"type":"string","minLength":1},
    "accepted_region_count":{"type":"integer","minimum":0},
    "accepted_region_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
    "accepted_coverage_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "missing_region_count":{"type":"integer","minimum":0},
    "missing_region_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
    "missing_region_set_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "missing_work_measure":{"type":"object"},
    "assignment_authority":{"const":"none"},
    "execution_authority":{"const":"none"},
    "settlement_authority":{"const":"none"},
    "laws":{"type":"array","items":{"type":"string"}},
    "exact_missing_region_set_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties":false
}