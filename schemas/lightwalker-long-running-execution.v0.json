{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-long-running-execution.v0.json",
  "title":"GHoT Lightwalker Long-Running Execution V0",
  "type":"object",
  "required":["kind","version","authority","guild_id","reservation_id","authorization_id","steward_particular","executor_particular","started_at_cut","start_execution_gate_id","start_evidence_path","status","progress_percent","last_checkpoint_id","checkpoint_count","partial_result_ref","service_complete","settlement_authority","laws","run_id","signing"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.long-running-execution"},
    "version":{"const":"0"},
    "authority":{"const":"owner-local-long-running-execution"},
    "guild_id":{"type":"string","minLength":1},
    "reservation_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "authorization_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "steward_particular":{"type":"string","minLength":1},
    "executor_particular":{"type":"string","minLength":1},
    "started_at_cut":{"type":"integer","minimum":0},
    "start_execution_gate_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "start_evidence_path":{"type":"string","minLength":1},
    "status":{"const":"RUNNING"},
    "progress_percent":{"const":0},
    "last_checkpoint_id":{"type":"null"},
    "checkpoint_count":{"const":0},
    "partial_result_ref":{"type":"null"},
    "service_complete":{"const":false},
    "settlement_authority":{"const":"none"},
    "laws":{"type":"array","items":{"type":"string"}},
    "run_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "signing":{"type":"object"}
  },
  "additionalProperties":false
}