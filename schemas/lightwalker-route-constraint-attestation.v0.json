{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-route-constraint-attestation.v0.json",
  "title":"GHoT Lightwalker Route Constraint Attestation V0",
  "type":"object",
  "required":["kind","version","authority","assessor_particular","capacity_guild_id","snapshot_id","remote_proof_id","resource_entry_id","observed_cut","facts","eligibility_authority","preference_authority","reservation_authority","laws","attestation_id","signing"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.route-constraint-attestation"},
    "version":{"const":"0"},
    "authority":{"const":"constraint-evidence-only"},
    "assessor_particular":{"type":"string","minLength":1},
    "capacity_guild_id":{"type":"string","minLength":1},
    "snapshot_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "remote_proof_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "resource_entry_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "observed_cut":{"type":"integer","minimum":0},
    "facts":{
      "type":"object",
      "required":["jurisdiction","privacy_class","renewable_evidence_present","sovereign_group"],
      "properties":{
        "jurisdiction":{"type":"string","minLength":1},
        "privacy_class":{"type":"integer","minimum":0},
        "renewable_evidence_present":{"type":"boolean"},
        "sovereign_group":{"type":"string","minLength":1}
      },
      "additionalProperties":false
    },
    "eligibility_authority":{"const":"none"},
    "preference_authority":{"const":"none"},
    "reservation_authority":{"const":"none"},
    "laws":{"type":"array","items":{"type":"string"}},
    "attestation_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "signing":{"type":"object"}
  },
  "additionalProperties":false
}