{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/lightwalker-heterogeneous-performance.v0.json",
  "title": "GHoT Lightwalker Heterogeneous Performance V0",
  "type": "object",
  "required": ["kind","version","offer_id","acceptance_id","role","actor_particular","obligation_id","evidence_ref","status","attestation_id","signing"],
  "properties": {
    "kind": { "const": "ghot.lightwalker.heterogeneous-performance" },
    "version": { "const": "0" },
    "offer_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "acceptance_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "role": { "enum": ["OFFEROR","ACCEPTOR"] },
    "actor_particular": { "type": "string", "minLength": 1 },
    "obligation_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "evidence_ref": { "type": "string", "minLength": 1 },
    "status": { "const": "FULFILLED" },
    "attestation_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "signing": { "type": "object" }
  },
  "additionalProperties": false
}
