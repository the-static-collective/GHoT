{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-resume-claim-decision.v0.json",
  "title":"GHoT Lightwalker Resume Claim Decision V0",
  "type":"object",
  "required":["kind","version","authority","source_run_id","source_checkpoint_id","source_stop_id","source_steward_particular","resume_claim_id","claimant_particular","candidate_reservation_id","active_resume_claim_id","observed_cut","status","execution_authority","claim_deleted","global_consensus","laws","claim_decision_id","signing"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.resume-claim-decision"},
    "version":{"const":"0"},
    "authority":{"const":"checkpoint-owner-local-resume-claim-decision"},
    "source_run_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "source_checkpoint_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "source_stop_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "source_steward_particular":{"type":"string","minLength":1},
    "resume_claim_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "claimant_particular":{"type":"string","minLength":1},
    "candidate_reservation_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "active_resume_claim_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "observed_cut":{"type":"integer","minimum":0},
    "status":{"enum":["ACTIVE","LOSING"]},
    "execution_authority":{"const":"none"},
    "claim_deleted":{"const":false},
    "global_consensus":{"const":false},
    "laws":{"type":"array","items":{"type":"string"}},
    "claim_decision_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "signing":{"type":"object"}
  },
  "additionalProperties":false
}