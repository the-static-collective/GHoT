{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/merge-plugin-author-signature.v0.json",
  "title": "GHoT Merge Plugin Author Signature V0",
  "type": "object",
  "required": [
    "kind","version","package_id","package_version","package_address",
    "particular","signed_at","signing"
  ],
  "properties": {
    "kind": { "const": "ghot.merge-plugin.author-signature" },
    "version": { "const": "0" },
    "package_id": { "type": "string", "minLength": 1 },
    "package_version": { "type": "string", "minLength": 1 },
    "package_address": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "particular": { "type": "string", "minLength": 1 },
    "signed_at": { "type": "string" },
    "signing": {
      "type": "object",
      "required": ["algorithm","public_key","signature","domain"],
      "properties": {
        "algorithm": { "const": "ECDSA-P256-SHA256" },
        "public_key": { "type": "object" },
        "signature": { "type": "string", "minLength": 1 },
        "domain": { "const": "ghot.merge-plugin-author-signature/v0" }
      }
    }
  }
}
