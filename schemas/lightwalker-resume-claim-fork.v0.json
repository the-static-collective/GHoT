{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-resume-claim-fork.v0.json",
  "title":"GHoT Lightwalker Resume Claim Fork V0",
  "type":"object",
  "required":["kind","version","authority","source_run_id","source_checkpoint_id","source_steward_particular","active_resume_claim_ids","active_decision_ids","status","global_consensus","claim_deleted","execution_authority","laws","fork_id"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.resume-claim-fork"},
    "version":{"const":"0"},
    "authority":{"const":"derived-resume-claim-fork-observation"},
    "source_run_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "source_checkpoint_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "source_steward_particular":{"type":"string","minLength":1},
    "active_resume_claim_ids":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
    "active_decision_ids":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
    "status":{"enum":["FORK","NO_FORK"]},
    "global_consensus":{"const":false},
    "claim_deleted":{"const":false},
    "execution_authority":{"const":"none"},
    "laws":{"type":"array","items":{"type":"string"}},
    "fork_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties":false
}