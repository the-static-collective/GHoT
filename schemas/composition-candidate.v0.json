{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/composition-candidate.v0.json",
  "title": "GHoT Composition Candidate V0",
  "type": "object",
  "required": [
    "candidate_id","match","source_particular","source_node_id",
    "exchange_url","advert_id","advert_issued_at","advert_address",
    "package_id","package_version","package_address","contract_id",
    "title","category","source","target","operation_kind",
    "author_particular"
  ],
  "properties": {
    "candidate_id": { "type": "string", "minLength": 1 },
    "match": { "const": "exact-source-shape" },
    "source_particular": { "type": "string", "minLength": 1 },
    "source_node_id": { "type": "string", "minLength": 1 },
    "exchange_url": { "type": "string", "minLength": 1 },
    "advert_id": { "type": "string", "minLength": 1 },
    "advert_issued_at": { "type": "string" },
    "advert_address": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "package_id": { "type": "string", "minLength": 1 },
    "package_version": { "type": "string", "minLength": 1 },
    "package_address": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "contract_id": { "type": "string", "minLength": 1 },
    "title": { "type": ["string","null"] },
    "category": { "type": ["string","null"] },
    "source": {
      "type": "object",
      "required": ["state_kind","state_version","selector","payload_type"]
    },
    "target": {
      "type": "object",
      "required": ["state_kind","state_version"]
    },
    "operation_kind": { "type": "string", "minLength": 1 },
    "author_particular": { "type": ["string","null"] }
  }
}
