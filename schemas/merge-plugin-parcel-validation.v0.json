{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/merge-plugin-parcel-validation.v0.json",
  "title": "GHoT Merge Plugin Parcel Validation V0",
  "type": "object",
  "required": [
    "kind","version","parcel_id","parcel_address","package_id",
    "package_address","author_signature_status","validated_at",
    "conformance","installable"
  ],
  "properties": {
    "kind": { "const": "ghot.merge-plugin.parcel.validation" },
    "version": { "const": "0" },
    "parcel_id": { "type": "string", "minLength": 1 },
    "parcel_address": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "package_id": { "type": "string", "minLength": 1 },
    "package_address": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "author_signature_status": { "enum": ["verified","unsigned"] },
    "validated_at": { "type": "string" },
    "conformance": { "type": "object" },
    "installable": { "type": "boolean" }
  }
}
