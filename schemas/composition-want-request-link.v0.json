{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/composition-want-request-link.v0.json",
  "title": "GHoT Composition Want Request Link V0",
  "type": "object",
  "required": [
    "kind","version","link_id","want_id","gap_id","candidate_id",
    "request_id","request_receipt_id","source_particular",
    "package_id","package_address","requested_at"
  ],
  "properties": {
    "kind": { "const": "ghot.composition.want-request-link" },
    "version": { "const": "0" },
    "link_id": { "type": "string", "minLength": 1 },
    "want_id": { "type": "string", "minLength": 1 },
    "gap_id": { "type": "string", "minLength": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "request_id": { "type": "string", "minLength": 1 },
    "request_receipt_id": { "type": "string", "minLength": 1 },
    "source_particular": { "type": "string", "minLength": 1 },
    "package_id": { "type": "string", "minLength": 1 },
    "package_address": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "requested_at": { "type": "string" }
  }
}
