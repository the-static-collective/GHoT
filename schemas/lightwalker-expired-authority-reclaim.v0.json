{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/lightwalker-expired-authority-reclaim.v0.json",
  "title": "GHoT Lightwalker Expired Authority Reclaim V0",
  "type": "object",
  "required": ["kind","version","authority","guild_id","snapshot_id","resource_entry_id","root_lease_id","dag_id","history_digest","steward_particular","expired_lease_id","expired_after_cut","observed_cut","unit","reclaimed_quantity","status","revival_requested","laws","reclaim_id","signing"],
  "properties": {
    "kind": { "const": "ghot.lightwalker.expired-authority-reclaim" },
    "version": { "const": "0" },
    "authority": { "const": "guild-local-expiry-reclaim" },
    "guild_id": { "type": "string", "minLength": 1 },
    "snapshot_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "resource_entry_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "root_lease_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "dag_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "history_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "steward_particular": { "type": "string", "minLength": 1 },
    "expired_lease_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "expired_after_cut": { "type": "integer", "minimum": 0 },
    "observed_cut": { "type": "integer", "minimum": 0 },
    "unit": { "type": "string", "minLength": 1 },
    "reclaimed_quantity": { "type": "integer", "minimum": 1 },
    "status": { "const": "RECLAIMED" },
    "revival_requested": { "const": false },
    "laws": { "type": "array", "items": { "type": "string" } },
    "reclaim_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "signing": { "type": "object" }
  },
  "additionalProperties": false
}