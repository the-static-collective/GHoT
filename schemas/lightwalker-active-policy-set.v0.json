{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-active-policy-set.v0.json",
  "title":"GHoT Lightwalker Active Policy Set V0",
  "type":"object",
  "required":["kind","version","authority","promise_id","route_policy_id","source_slot_id","observed_cut","active_versions","superseded_policy_version_ids","retroactive_rewrite","automatic_authority_carry_forward","reservation_authority","laws","policy_set_id"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.active-policy-set"},
    "version":{"const":"0"},
    "authority":{"const":"derived-active-policy-set-only"},
    "promise_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "route_policy_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "source_slot_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "observed_cut":{"type":"integer","minimum":0},
    "active_versions":{"type":"array","minItems":1,"items":{"type":"object"}},
    "superseded_policy_version_ids":{"type":"array","items":{"type":"string"}},
    "retroactive_rewrite":{"const":false},
    "automatic_authority_carry_forward":{"const":false},
    "reservation_authority":{"const":"none"},
    "laws":{"type":"array","items":{"type":"string"}},
    "policy_set_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties":false
}