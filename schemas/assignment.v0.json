{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/assignment.v0.json",
  "title": "GHoT Assignment V0",
  "type": "object",
  "required": ["kind", "version", "assignment_id", "offer_id", "selected_node_id", "capability", "selection_source", "created_at", "laws"],
  "properties": {
    "kind": { "const": "ghot.assignment" },
    "version": { "const": "0" },
    "assignment_id": { "type": "string", "minLength": 1 },
    "offer_id": { "type": "string", "pattern": "^ghot-body-offer-v0:" },
    "selected_node_id": { "type": "string", "minLength": 1 },
    "capability": { "type": "string", "minLength": 1 },
    "selection_source": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string" },
    "offered_body": { "type": "object" },
    "revalidated_body": { "type": "object" },
    "laws": { "type": "array", "items": { "type": "string" } }
  }
}
