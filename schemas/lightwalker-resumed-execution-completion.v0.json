{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-resumed-execution-completion.v0.json",
  "title":"GHoT Lightwalker Resumed Execution Completion V0",
  "type":"object",
  "required":["kind","version","authority","resume_id","old_run_id","source_checkpoint_id","source_partial_result_ref","new_reservation_id","new_steward_particular","new_executor_particular","completed_at_cut","completion_gate_id","completion_evidence_path","prior_progress_percent","remaining_work_percent","new_work_counted_percent","source_work_measure","prior_work_measure","new_work_counted_measure","total_progress_percent","result_ref","execution_receipt_id","reservation_finalization_id","reservation_status","prior_work_reexecuted","prior_work_double_counted","service_complete","settlement_authority","ownership_transfer","old_run_rewritten","laws","resumed_completion_id","signing"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.resumed-execution-completion"},
    "version":{"const":"0"},
    "authority":{"const":"owner-local-resumed-completion"},
    "resume_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "old_run_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "source_checkpoint_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "source_partial_result_ref":{"type":"string","minLength":1},
    "new_reservation_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "new_steward_particular":{"type":"string","minLength":1},
    "new_executor_particular":{"type":"string","minLength":1},
    "completed_at_cut":{"type":"integer","minimum":0},
    "completion_gate_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "completion_evidence_path":{"type":"string","minLength":1},
    "prior_progress_percent":{"type":"integer","minimum":1,"maximum":99},
    "remaining_work_percent":{"type":"integer","minimum":1,"maximum":99},
    "new_work_counted_percent":{"type":"integer","minimum":1,"maximum":99},
    "source_work_measure":{"type":"object"},
    "prior_work_measure":{"type":"object"},
    "new_work_counted_measure":{"type":"object"},
    "total_progress_percent":{"const":100},
    "result_ref":{"type":"string","minLength":1},
    "execution_receipt_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "reservation_finalization_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "reservation_status":{"const":"CONSUMED"},
    "prior_work_reexecuted":{"const":false},
    "prior_work_double_counted":{"const":false},
    "service_complete":{"const":true},
    "settlement_authority":{"const":"none"},
    "ownership_transfer":{"const":false},
    "old_run_rewritten":{"const":false},
    "laws":{"type":"array","items":{"type":"string"}},
    "resumed_completion_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "signing":{"type":"object"}
  },
  "additionalProperties":false
}