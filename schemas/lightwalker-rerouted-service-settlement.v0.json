{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-rerouted-service-settlement.v0.json",
  "title":"GHoT Lightwalker Rerouted Service Settlement V0",
  "type":"object",
  "required":["kind","version","authority","promisor_particular","promise_id","reroute_ids","aggregate_id","promisor_attestation_id","customer_attestation_id","settlement_id","performed_measure","customer_service_performed","promise_rewritten","route_history_preserved","ownership_aggregated","payment_inferred_from_route_execution","laws","witness_id"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.rerouted-service-settlement"},
    "version":{"const":"0"},
    "authority":{"const":"derived-rerouted-service-linkage"},
    "promisor_particular":{"type":"string","minLength":1},
    "promise_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "reroute_ids":{"type":"array","items":{"type":"string"}},
    "aggregate_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "promisor_attestation_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "customer_attestation_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "settlement_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "performed_measure":{"type":"object"},
    "customer_service_performed":{"const":true},
    "promise_rewritten":{"const":false},
    "route_history_preserved":{"const":true},
    "ownership_aggregated":{"const":false},
    "payment_inferred_from_route_execution":{"const":false},
    "laws":{"type":"array","items":{"type":"string"}},
    "witness_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties":false
}