{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/lightwalker-distributed-reservation-resolution.v0.json",
  "title": "GHoT Lightwalker Distributed Reservation Resolution V0",
  "type": "object",
  "required": ["kind","version","authority","guild_id","snapshot_id","resource_entry_id","reconciliation_id","claim_ids","steward_particular","rule","selected_claim_ids","superseded_claim_ids","laws","resolution_id","signing"],
  "properties": {
    "kind": { "const": "ghot.lightwalker.distributed-reservation-resolution" },
    "version": { "const": "0" },
    "authority": { "const": "guild-local-conflict-resolution" },
    "guild_id": { "type": "string", "minLength": 1 },
    "snapshot_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "resource_entry_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "reconciliation_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "claim_ids": { "type": "array", "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } },
    "steward_particular": { "type": "string", "minLength": 1 },
    "rule": { "const": "lowest-claim-id" },
    "selected_claim_ids": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } },
    "superseded_claim_ids": { "type": "array", "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } },
    "laws": { "type": "array", "items": { "type": "string" } },
    "resolution_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "signing": { "type": "object" }
  },
  "additionalProperties": false
}