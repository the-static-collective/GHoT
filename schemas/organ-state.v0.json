{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/organ-state.v0.json",
  "title": "GHoT Organ State V0",
  "type": "object",
  "required": [
    "kind","version","node_id","started_at","updated_at","cycle",
    "body","field","authorities","work","services","errors"
  ],
  "properties": {
    "kind": { "const": "ghot.organ.state" },
    "version": { "const": "0" },
    "node_id": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "cycle": { "type": "integer", "minimum": 1 },
    "body": { "type": "object" },
    "field": { "type": "object" },
    "authorities": { "type": "array", "items": { "type": "object" } },
    "work": { "type": "object" },
    "services": { "type": "object" },
    "errors": { "type": "array", "items": { "type": "object" } }
  }
}
