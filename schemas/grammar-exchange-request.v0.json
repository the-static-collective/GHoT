{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/grammar-exchange-request.v0.json",
  "title": "GHoT Grammar Exchange Request V0",
  "type": "object",
  "required": [
    "kind","version","request_id","target_particular","nonce",
    "package_id","package_address","requester","created_at",
    "ttl_seconds","signing"
  ],
  "properties": {
    "kind": { "const": "ghot.grammar.exchange.request" },
    "version": { "const": "0" },
    "request_id": { "type": "string", "minLength": 1 },
    "target_particular": { "type": "string", "minLength": 1 },
    "nonce": { "type": "string", "minLength": 1 },
    "package_id": { "type": "string", "minLength": 1 },
    "package_address": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "requester": {
      "type": "object",
      "required": ["node_id","particular","public_key","return_parcel_port"],
      "properties": {
        "node_id": { "type": "string", "minLength": 1 },
        "particular": { "type": "string", "minLength": 1 },
        "public_key": { "type": "object" },
        "return_parcel_port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "created_at": { "type": "string" },
    "ttl_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
    "signing": {
      "type": "object",
      "required": ["algorithm","public_key","signature","domain"],
      "properties": {
        "algorithm": { "const": "ECDSA-P256-SHA256" },
        "public_key": { "type": "object" },
        "signature": { "type": "string", "minLength": 1 },
        "domain": { "const": "ghot.grammar-exchange-request-signature/v0" }
      }
    }
  }
}
