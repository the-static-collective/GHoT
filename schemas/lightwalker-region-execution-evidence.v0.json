{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-region-execution-evidence.v0.json",
  "title":"GHoT Lightwalker Region Execution Evidence V0",
  "type":"object",
  "required":["kind","version","authority","pixel_region_plan_id","work_address","region_claim_set_id","executor_particular","execution_receipt_id","reservation_id","finalization_id","region_count","region_claims","work_measure","continuation_authority","settlement_authority","laws","region_execution_evidence_id"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.region-execution-evidence"},
    "version":{"const":"0"},
    "authority":{"const":"derived-exact-region-execution-evidence"},
    "pixel_region_plan_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "work_address":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "region_claim_set_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "executor_particular":{"type":"string","minLength":1},
    "execution_receipt_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "reservation_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "finalization_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "region_count":{"type":"integer","minimum":1},
    "region_claims":{"type":"array","minItems":1,"items":{"type":"object"}},
    "work_measure":{"type":"object"},
    "continuation_authority":{"const":"none"},
    "settlement_authority":{"const":"none"},
    "laws":{"type":"array","items":{"type":"string"}},
    "region_execution_evidence_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties":false
}