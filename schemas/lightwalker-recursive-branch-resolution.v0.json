{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-recursive-branch-resolution.v0.json",
  "title":"GHoT Lightwalker Recursive Branch Resolution V0",
  "type":"object",
  "required":["kind","version","authority","recursive_branch_fork_id","continuation_lineage_id","parent_node_id","parent_checkpoint_id","parent_steward_particular","rule","branch_handoff_ids","branch_child_node_ids","winning_handoff_id","winning_child_node_id","losing_handoff_ids","losing_child_node_ids","history_deleted","global_consensus","execution_authority","laws","recursive_branch_resolution_id","signing"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.recursive-branch-resolution"},
    "version":{"const":"0"},
    "authority":{"const":"parent-owner-local-recursive-fork-resolution"},
    "recursive_branch_fork_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "continuation_lineage_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "parent_node_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "parent_checkpoint_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "parent_steward_particular":{"type":"string","minLength":1},
    "rule":{"const":"lowest-handoff-id"},
    "branch_handoff_ids":{"type":"array","minItems":2,"uniqueItems":true,"items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
    "branch_child_node_ids":{"type":"array","minItems":2,"uniqueItems":true,"items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
    "winning_handoff_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "winning_child_node_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "losing_handoff_ids":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
    "losing_child_node_ids":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
    "history_deleted":{"const":false},
    "global_consensus":{"const":false},
    "execution_authority":{"const":"none"},
    "laws":{"type":"array","items":{"type":"string"}},
    "recursive_branch_resolution_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "signing":{"type":"object"}
  },
  "additionalProperties":false
}