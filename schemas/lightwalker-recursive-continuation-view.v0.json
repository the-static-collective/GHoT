{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-recursive-continuation-view.v0.json",
  "title":"GHoT Lightwalker Recursive Continuation View V0",
  "type":"object",
  "required":["kind","version","authority","continuation_lineage_id","root_run_id","root_checkpoint_id","root_source_work_measure","seed_node_id","recursive_depth","node_ids","edge_ids","handoff_ids","checkpoint_ancestry","checkpoint_ids_observed","resource_reservation_ids","resource_reservations_distinct","status","live_leaf_ids","live_leaf_count","terminal_leaf_id","tip_node_id","tip_prior_progress_percent","tip_prior_work_measure","tip_remaining_work_measure","ancestry_digest","global_consensus","execution_authority","history_collapsed","laws","recursive_view_id"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.recursive-continuation-view"},
    "version":{"const":"0"},
    "authority":{"const":"derived-recursive-continuation-observation"},
    "continuation_lineage_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "root_run_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "root_checkpoint_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "root_source_work_measure":{"type":"object"},
    "seed_node_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "recursive_depth":{"type":"integer","minimum":2},
    "node_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
    "edge_ids":{"type":"array","items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
    "handoff_ids":{"type":"array","items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
    "checkpoint_ancestry":{"type":"array","minItems":2,"uniqueItems":true,"items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
    "checkpoint_ids_observed":{"type":"array","minItems":2,"items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
    "resource_reservation_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
    "resource_reservations_distinct":{"const":true},
    "status":{"enum":["ACTIVE","COMPLETED"]},
    "live_leaf_ids":{"type":"array","maxItems":1,"items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
    "live_leaf_count":{"type":"integer","minimum":0,"maximum":1},
    "terminal_leaf_id":{"type":["string","null"]},
    "tip_node_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "tip_prior_progress_percent":{"type":"integer","minimum":1,"maximum":99},
    "tip_prior_work_measure":{"type":"object"},
    "tip_remaining_work_measure":{"type":"object"},
    "ancestry_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "global_consensus":{"const":false},
    "execution_authority":{"const":"none"},
    "history_collapsed":{"const":false},
    "laws":{"type":"array","items":{"type":"string"}},
    "recursive_view_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties":false
}