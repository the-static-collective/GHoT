{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/merge-plugin-package.v0.json",
  "title": "GHoT Declarative Merge Plugin Package V0",
  "type": "object",
  "required": [
    "kind","version","package_id","package_version",
    "contract","schemas","operation","fixtures"
  ],
  "properties": {
    "kind": { "const": "ghot.merge-plugin.package" },
    "version": { "const": "0" },
    "package_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "package_version": { "type": "string", "minLength": 1 },
    "contract": {
      "type": "object",
      "required": [
        "contract_id","title","description","category",
        "source","target","authority_effect","freshness_effect",
        "selection_required"
      ],
      "properties": {
        "contract_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "source": {
          "type": "object",
          "required": ["state_kind","state_version","selector","payload_type"],
          "properties": {
            "state_kind": { "type": "string", "minLength": 1 },
            "state_version": { "type": "string", "minLength": 1 },
            "selector": { "type": "string" },
            "payload_type": { "const": "object" }
          }
        },
        "target": {
          "type": "object",
          "required": ["relative_path","state_kind","state_version"],
          "properties": {
            "relative_path": { "type": "string", "minLength": 1 },
            "state_kind": { "type": "string", "minLength": 1 },
            "state_version": { "type": "string", "minLength": 1 }
          }
        },
        "authority_effect": { "const": "none" },
        "freshness_effect": { "const": "none" },
        "selection_required": { "const": true }
      }
    },
    "schemas": {
      "type": "object",
      "required": ["target"],
      "properties": {
        "target": {
          "type": "object",
          "required": ["kind","version","shape"],
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "shape": { "const": "catalog" }
          }
        }
      }
    },
    "operation": {
      "type": "object",
      "required": ["kind","entry_fields","key_fields"],
      "properties": {
        "kind": { "const": "catalog-object-snapshot/v0" },
        "entry_fields": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "key_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["name","local_before","parcel","expected_after"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "local_before": { "type": "object" },
          "parcel": { "type": "object" },
          "expected_after": { "type": "object" }
        }
      }
    }
  }
}
