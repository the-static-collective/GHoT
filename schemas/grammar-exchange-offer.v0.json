{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-static-collective.github.io/GHoT/schemas/grammar-exchange-offer.v0.json",
  "title": "GHoT Grammar Exchange Offer V0",
  "type": "object",
  "required": [
    "kind","version","request_id","package_id","package_address",
    "parcel_id","parcel_address","crossing_id","requester_particular",
    "return_url","receiver_receipt_id","author_particular",
    "offered_at","note","installed_remotely"
  ],
  "properties": {
    "kind": { "const": "ghot.grammar.exchange.offer" },
    "version": { "const": "0" },
    "request_id": { "type": "string", "minLength": 1 },
    "package_id": { "type": "string", "minLength": 1 },
    "package_address": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "parcel_id": { "type": "string", "minLength": 1 },
    "parcel_address": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "crossing_id": { "type": "string", "minLength": 1 },
    "requester_particular": { "type": "string", "minLength": 1 },
    "return_url": { "type": "string", "minLength": 1 },
    "receiver_receipt_id": { "type": "string", "minLength": 1 },
    "author_particular": { "type": ["string","null"] },
    "offered_at": { "type": "string" },
    "note": { "type": ["string","null"] },
    "installed_remotely": { "const": false }
  }
}
