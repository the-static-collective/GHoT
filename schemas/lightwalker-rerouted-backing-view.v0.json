{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-rerouted-backing-view.v0.json",
  "title":"GHoT Lightwalker Rerouted Backing View V0",
  "type":"object",
  "required":["kind","version","authority","promise_id","reroute_ids","effective_grant_ids","missing_source_slot_ids","routes","required_measure","reserved_measure","status","execution_authority","ownership_aggregated","promise_rewritten","laws","backing_id"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.rerouted-backing-view"},
    "version":{"const":"0"},
    "authority":{"const":"derived-rerouted-backing-view"},
    "promise_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "reroute_ids":{"type":"array","items":{"type":"string"}},
    "effective_grant_ids":{"type":"array","items":{"type":"string"}},
    "missing_source_slot_ids":{"type":"array","items":{"type":"string"}},
    "routes":{"type":"array","items":{"type":"object"}},
    "required_measure":{"type":"object"},
    "reserved_measure":{"type":"object"},
    "status":{"enum":["PARTIAL","COMPLETE"]},
    "execution_authority":{"const":"none"},
    "ownership_aggregated":{"const":false},
    "promise_rewritten":{"const":false},
    "laws":{"type":"array","items":{"type":"string"}},
    "backing_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties":false
}