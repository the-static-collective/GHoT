{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://the-static-collective.github.io/GHoT/schemas/lightwalker-sparse-region-work-close.v0.json",
  "title":"GHoT Lightwalker Sparse Region Work Close V0",
  "type":"object",
  "required":["kind","version","authority","sparse_region_lease_id","exact_missing_region_set_id","assigner_particular","node_particular","consumed_region_ids","returned_region_ids","consumed_work_measure","returned_work_measure","node_release_id","observed_cut","status","history_deleted","laws","sparse_region_close_id","signing"],
  "properties":{
    "kind":{"const":"ghot.lightwalker.sparse-region-work-close"},
    "version":{"const":"0"},
    "authority":{"const":"owner-local-sparse-region-close"},
    "sparse_region_lease_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "exact_missing_region_set_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "assigner_particular":{"type":"string","minLength":1},
    "node_particular":{"type":"string","minLength":1},
    "consumed_region_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
    "returned_region_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
    "consumed_work_measure":{"type":"object"},
    "returned_work_measure":{"type":"object"},
    "node_release_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "observed_cut":{"type":"integer","minimum":0},
    "status":{"const":"CLOSED"},
    "history_deleted":{"const":false},
    "laws":{"type":"array","items":{"type":"string"}},
    "sparse_region_close_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "signing":{"type":"object"}
  },
  "additionalProperties":false
}